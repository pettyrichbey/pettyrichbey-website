---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Tunnel of Love: ACT I — Masterpiece Theatre | Petty Rich Bey"
  description="Enter Tunnel of Love: ACT I — Masterpiece Theatre, the new R&B album from Petty Rich Bey. Coming January 15, 2027."
>
  <section class="relative isolate overflow-hidden px-6 py-24 md:px-10 md:py-32">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,rgba(214,184,135,.16),transparent_48%),linear-gradient(145deg,#35101f,#170f13_58%,#100b0e)]"></div>
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-4xl text-center">
        <p class="prb-kicker">Petty Rich Bey presents</p>
        <p class="mt-8 text-sm uppercase tracking-[0.55em] text-[#d6b887]">A new R&amp;B experience</p>
        <h1 class="logo mt-6 text-5xl leading-tight text-[#f5efe5] md:text-7xl lg:text-8xl">Tunnel of Love</h1>
        <p class="mt-4 text-xl uppercase tracking-[0.32em] text-[#d6b887] md:text-2xl">ACT I · Masterpiece Theatre</p>
        <p class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-[#e4d8d1]">
          A beautiful, seductive carnival of love, desire, and late-night emotion—with shadows waiting just beyond the lights.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <span class="rounded-full border border-[#d6b887]/40 px-5 py-2 text-sm text-[#f5efe5]">19 tracks</span>
          <span class="rounded-full border border-[#d6b887]/40 px-5 py-2 text-sm text-[#f5efe5]">January 15, 2027</span>
          <span class="rounded-full border border-[#d6b887]/40 px-5 py-2 text-sm text-[#f5efe5]">$9.99</span>
        </div>
      </div>

      <div class="mx-auto mt-20 grid max-w-5xl gap-8 lg:grid-cols-[1.1fr_.9fr]">
        <div class="prb-panel flex min-h-[360px] flex-col justify-center p-8 md:p-12">
          <p class="prb-kicker">The experience</p>
          <h2 class="logo mt-5 text-4xl text-[#f5efe5] md:text-5xl">Step inside the theatre.</h2>
          <p class="mt-6 leading-8 text-[#d8c9c2]">
            ACT I opens the Tunnel of Love story with a cinematic R&amp;B journey. Let the music pull you in, follow the story, and discover what waits behind the curtain.
          </p>
          <p class="mt-8 text-sm leading-6 text-[#bcaeaa]">
            The full 19-track album download will be available with purchase. The private album file is not hosted as a public download.
          </p>
        </div>

        <div class="rounded-3xl border border-[#d6b887]/30 bg-[#24171c]/90 p-8 md:p-10">
          <p class="prb-kicker">The first act</p>
          <h2 class="logo mt-4 text-3xl text-[#f5efe5]">Own the album</h2>
          <p class="mt-4 text-4xl font-semibold text-[#d6b887]">$9.99</p>
          <p class="mt-4 leading-7 text-[#d8c9c2]">
            Get the complete ACT I album as a digital download when it releases.
          </p>
          <div class="mt-8 rounded-2xl border border-[#d6b887]/20 bg-black/20 p-5">
            <p class="text-sm font-semibold text-[#f5efe5]">Release date</p>
            <p class="mt-1 text-[#d6b887]">Friday, January 15, 2027</p>
          </div>
          <p class="mt-6 text-sm leading-6 text-[#bcaeaa]">
            Secure checkout and instant private delivery will be connected after the payment and download endpoints are verified.
          </p>
        </div>
      </div>

      <div class="mx-auto mt-16 max-w-5xl border-t border-[#d6b887]/20 pt-10 text-center">
        <p class="prb-kicker">The opening number</p>
        <h2 class="logo mt-4 text-3xl text-[#f5efe5] md:text-4xl">INTOXICATED</h2>
        <p class="mx-auto mt-4 max-w-xl leading-7 text-[#cbbdb6]">
          The first taste of Tunnel of Love. The public preview player will appear here once its secure streaming address is confirmed.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
