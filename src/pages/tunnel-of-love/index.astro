---
import BaseLayout from "../../layouts/BaseLayout.astro";

const worker = "https://prb-digital-delivery.pettyrichbey.workers.dev";
---

<BaseLayout
  title="Tunnel of Love: ACT I — Early Access | Petty Rich Bey"
  description="Buy INTOXICATED, the lead single, or get early access to the complete Tunnel of Love: ACT I — Masterpiece Theatre album directly from Petty Rich Bey."
>
  <main class="overflow-hidden bg-[#080808] text-[#f1eee8]">
    <section class="relative isolate px-5 pb-20 pt-16 md:px-8 md:pb-28 md:pt-24">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_18%_12%,rgba(170,170,170,.08),transparent_42%),radial-gradient(ellipse_at_85%_65%,rgba(214,195,154,.08),transparent_40%),linear-gradient(145deg,#171717,#090909_60%,#050505)]"></div>
      <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_.9fr]">
        <div>
          <p class="prb-kicker text-xs md:text-sm">Petty Rich Bey presents</p>
          <h1 class="logo mt-6 text-5xl leading-tight md:text-7xl">Tunnel of Love</h1>
          <p class="mt-3 text-sm uppercase tracking-[.35em] text-[#d8c39a] md:text-lg">ACT I · Masterpiece Theatre</p>
          <p class="mt-7 max-w-xl text-lg leading-8 text-[#c9c6c0]">
            A beautiful, seductive carnival of love, desire, and late-night emotion—with shadows waiting just beyond the lights.
          </p>
          <div class="mt-9 flex flex-wrap gap-3 text-xs uppercase tracking-widest text-[#d0ccc5]">
            <span class="rounded-full border border-[#d8c39a]/40 px-4 py-2">19-track album</span>
            <span class="rounded-full border border-[#d8c39a]/40 px-4 py-2">Early access available</span>
            <span class="rounded-full border border-[#d8c39a]/40 px-4 py-2">Official streaming · Feb 12, 2027</span>
          </div>
          <a href="#shop" class="prb-button mt-9">Shop early access</a>
        </div>
        <div class="mx-auto w-full max-w-[470px]">
          <div class="overflow-hidden rounded-[1.6rem] border border-[#d8c39a]/30 shadow-[0_25px_90px_rgba(0,0,0,.7)]">
            <img
              src={`${worker}/media/intoxicated-thumbnail`}
              alt="INTOXICATED single cover by Petty Rich Bey"
              class="aspect-square w-full object-cover"
              loading="eager"
            />
          </div>
          <p class="mt-4 text-center text-xs uppercase tracking-[.3em] text-[#aaa49a]">The lead single · INTOXICATED</p>
          <div class="mt-6 rounded-xl border border-[var(--prb-line)] bg-[#101010] p-4 shadow-[0_12px_40px_rgba(0,0,0,.45)]">
            <p class="mb-3 text-center text-[10px] uppercase tracking-[.25em] text-[var(--prb-muted)]">Listen to the lead single</p>
            <audio controls preload="none" class="w-full" aria-label="INTOXICATED audio preview">
              <source src={`${worker}/media/intoxicated`} type="audio/mpeg" />
              Your browser does not support audio playback.
            </audio>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-[var(--prb-line)] bg-[#050505] px-5 py-16 md:px-8 md:py-20">
      <div class="mx-auto max-w-5xl">
        <div class="mx-auto mb-8 max-w-2xl text-center">
          <p class="prb-kicker text-xs">The official motion picture preview</p>
          <h2 class="prb-display mt-4 text-3xl md:text-5xl">The <span class="prb-italic text-[var(--prb-champagne)]">trailer.</span></h2>
          <p class="mt-4 text-sm leading-7 text-[var(--prb-muted)]">Step inside the world of Tunnel of Love: ACT I — Masterpiece Theatre.</p>
        </div>
        <div class="overflow-hidden rounded-xl border border-[var(--prb-line)] bg-black shadow-[0_25px_80px_rgba(0,0,0,.7)]">
          <div class="aspect-video w-full">
            <iframe
              class="h-full w-full"
              src="https://www.youtube-nocookie.com/embed/VALrDD44-6o?rel=0"
              title="Tunnel of Love: ACT I — official trailer by Petty Rich Bey"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        </div>
        <div class="mt-8 overflow-hidden rounded-xl border border-[var(--prb-line)] bg-black p-2 md:p-3">
          <div class="flex min-h-28 items-center justify-center bg-[#090909] px-5 py-8 text-center">
            <p class="text-xs uppercase tracking-[.28em] text-[var(--prb-muted)]">INTOXICATED teaser artwork · full-width presentation coming next</p>
          </div>
        </div>
      </div>
    </section>


    <!-- Release countdown and campaign calendar -->
    <section id="road-to-masterpiece" class="border-y border-[#d8c39a]/20 bg-[radial-gradient(ellipse_at_50%_0%,rgba(216,195,154,.09),transparent_55%),#090909] px-5 py-16 md:px-8 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-3xl text-center">
          <p class="prb-kicker text-xs">The road to Masterpiece Theatre</p>
          <h2 class="logo mt-4 text-4xl md:text-5xl">The curtain is almost up.</h2>
          <p class="mx-auto mt-4 max-w-2xl leading-7 text-[#bdb9b1]">Follow every premiere, private listening room, and special appearance leading to the full album release.</p>
        </div>

        <div class="mx-auto mt-10 max-w-4xl rounded-3xl border border-[#d8c39a]/35 bg-[linear-gradient(145deg,#211a17,#0b0b0b_72%)] p-6 shadow-[0_20px_70px_rgba(0,0,0,.55)] md:p-9">
          <p class="text-center text-[10px] uppercase tracking-[.4em] text-[#d8c39a]">The official album countdown</p>
          <div id="tol-countdown" class="mt-6 grid grid-cols-4 gap-2 text-center" aria-live="off">
            <div class="rounded-xl border border-[#d8c39a]/15 bg-black/50 px-2 py-4"><p id="tol-days" class="text-3xl font-semibold tabular-nums text-[#f1eee8] md:text-5xl">--</p><p class="mt-2 text-[9px] uppercase tracking-[.25em] text-[#b5a58a]">Days</p></div>
            <div class="rounded-xl border border-[#d8c39a]/15 bg-black/50 px-2 py-4"><p id="tol-hours" class="text-3xl font-semibold tabular-nums text-[#f1eee8] md:text-5xl">--</p><p class="mt-2 text-[9px] uppercase tracking-[.25em] text-[#b5a58a]">Hours</p></div>
            <div class="rounded-xl border border-[#d8c39a]/15 bg-black/50 px-2 py-4"><p id="tol-minutes" class="text-3xl font-semibold tabular-nums text-[#f1eee8] md:text-5xl">--</p><p class="mt-2 text-[9px] uppercase tracking-[.25em] text-[#b5a58a]">Minutes</p></div>
            <div class="rounded-xl border border-[#d8c39a]/15 bg-black/50 px-2 py-4"><p id="tol-seconds" class="text-3xl font-semibold tabular-nums text-[#f1eee8] md:text-5xl">--</p><p class="mt-2 text-[9px] uppercase tracking-[.25em] text-[#b5a58a]">Seconds</p></div>
          </div>
          <p id="tol-countdown-label" class="mt-6 text-center text-xs uppercase tracking-[.3em] text-[#d8c39a]">Friday · February 12, 2027</p>
          <p class="mt-3 text-center text-sm text-[#aaa49a]">Tunnel of Love: ACT I — Masterpiece Theatre</p>
        </div>

        <div class="mt-14">
          <div class="mb-7 text-center">
            <p class="prb-kicker text-xs">The official schedule</p>
            <h3 class="logo mt-3 text-3xl md:text-4xl">Before the grand opening</h3>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            <article class="rounded-2xl border border-[#d8c39a]/25 bg-[#111] p-6">
              <p class="text-[10px] uppercase tracking-[.3em] text-[#d8c39a]">Friday · January 15, 2027</p>
              <h4 class="logo mt-3 text-2xl">INTOXICATED</h4>
              <p class="mt-2 text-sm text-[#bdb9b1]">Lead single premiere — the first invitation into the theatre.</p>
            </article>
            <article class="rounded-2xl border border-[#d8c39a]/25 bg-[#111] p-6">
              <p class="text-[10px] uppercase tracking-[.3em] text-[#d8c39a]">Saturday · January 16, 2027 · 7–9 PM Central</p>
              <h4 class="logo mt-3 text-2xl">Private Listening Room</h4>
              <p class="mt-2 text-sm text-[#bdb9b1]">Session One · Invitation only · Limited to 20 guests.</p>
            </article>
            <article class="rounded-2xl border border-[#d8c39a]/25 bg-[#111] p-6">
              <p class="text-[10px] uppercase tracking-[.3em] text-[#d8c39a]">Saturday · January 23, 2027 · 7–9 PM Central</p>
              <h4 class="logo mt-3 text-2xl">Private Listening Room</h4>
              <p class="mt-2 text-sm text-[#bdb9b1]">Session Two · Invitation only · Limited to 20 guests.</p>
            </article>
            <article class="rounded-2xl border border-[#d8c39a]/25 bg-[#111] p-6">
              <p class="text-[10px] uppercase tracking-[.3em] text-[#d8c39a]">Friday · January 29, 2027</p>
              <h4 class="logo mt-3 text-2xl">Crepes &amp; Warm Wine, Pt. 2</h4>
              <p class="mt-2 text-sm text-[#bdb9b1]">The second single from Tunnel of Love: ACT I — Masterpiece Theatre.</p>
            </article>
            <article class="rounded-2xl border border-[#d8c39a]/25 bg-[#111] p-6">
              <p class="text-[10px] uppercase tracking-[.3em] text-[#d8c39a]">Friday · February 5, 2027</p>
              <h4 class="logo mt-3 text-2xl">Inside the Tunnel of Love</h4>
              <p class="mt-2 text-sm text-[#bdb9b1]">Petty Rich Bey LIVE on TikTok. Live time to be announced.</p>
            </article>
            <article class="rounded-2xl border border-[#d8c39a]/25 bg-[#111] p-6">
              <p class="text-[10px] uppercase tracking-[.3em] text-[#d8c39a]">Radio premieres</p>
              <h4 class="logo mt-3 text-2xl">DJ Pain Radio &amp; DJ Seizure</h4>
              <p class="mt-2 text-sm text-[#bdb9b1]">Tune-in premieres with our radio partners. Broadcast dates and times will be announced.</p>
            </article>
          </div>
        </div>

        <div class="mx-auto mt-10 max-w-4xl rounded-2xl border border-[#d8c39a]/35 bg-[linear-gradient(135deg,#1c1715,#0b0b0b)] p-7 text-center md:p-9">
          <p class="prb-kicker text-xs">Limited private access</p>
          <h3 class="logo mt-3 text-3xl md:text-4xl">Request your invitation.</h3>
          <p class="mx-auto mt-4 max-w-2xl leading-7 text-[#c9c6c0]">Want to join one of the private virtual listening sessions? Email us to request a place in the room. Each session is limited to 20 guests. Sending a request does not guarantee a seat; invitations are confirmed individually.</p>
          <p class="mt-4 text-sm text-[#d8c39a]">January 16 or January 23 · 7–9 PM Central</p>
          <a class="prb-button mt-7 inline-flex" href="mailto:contact@pettyrichbey.com?subject=Tunnel%20of%20Love%20Private%20Listening%20Party%20Request&amp;body=Hello%2C%0A%0AI%27d%20like%20to%20request%20an%20invitation%20to%20the%20Tunnel%20of%20Love%3A%20ACT%20I%20private%20listening%20party.%0A%0APreferred%20session%3A%20January%2016%20or%20January%2023%2C%202027.%0A%0AThank%20you.">Email to request an invitation</a>
          <p class="mt-4 text-xs text-[#8e8981]">Please include your preferred session date. Access details are sent only to confirmed guests.</p>
        </div>
      </div>
    </section>

    <section id="shop" class="px-5 py-20 md:px-8 md:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-2xl text-center">
          <p class="prb-kicker text-xs">The Petty Rich Bey early access store</p>
          <h2 class="logo mt-4 text-4xl md:text-5xl">Choose your experience.</h2>
          <p class="mt-5 leading-7 text-[#bdb9b1]">Get the single or own the complete first act before the official streaming release.</p>
        </div>

        <div class="mt-12 grid gap-7 md:grid-cols-2">
          <article class="overflow-hidden rounded-3xl border border-[#d8c39a]/30 bg-[#111111] shadow-2xl">
            <img
              src={`${worker}/media/intoxicated-thumbnail`}
              alt="INTOXICATED single cover"
              class="aspect-square w-full object-cover"
              loading="lazy"
            />
            <div class="p-7 md:p-9">
              <p class="prb-kicker text-[11px]">Lead single · Early access</p>
              <h3 class="logo mt-3 text-3xl">INTOXICATED</h3>
              <p class="mt-4 text-4xl font-semibold text-[#d8c39a]">$0.99</p>
              <ul class="mt-5 space-y-2 text-sm leading-6 text-[#c8c4bc]">
                <li>• One digital MP3 single</li>
                <li>• Secure checkout through PayPal</li>
                <li>• Private download after successful payment</li>
              </ul>
              <button class="prb-button mt-8 w-full" data-product="PRB-INTOXICATED-SINGLE">Buy single · $0.99</button>
            </div>
          </article>

          <article class="flex flex-col rounded-3xl border border-[#d8c39a]/30 bg-[linear-gradient(150deg,#202020,#0b0b0b_70%)] p-7 shadow-2xl md:p-9">
            <div class="flex flex-1 flex-col justify-center">
              <p class="prb-kicker text-[11px]">The complete first act · Early access</p>
              <div class="mt-7 flex aspect-square w-full items-center justify-center rounded-2xl border border-[#d8c39a]/25 bg-[radial-gradient(ellipse_at_50%_35%,rgba(214,195,154,.12),transparent_55%),linear-gradient(145deg,#242424,#090909)] p-8 text-center">
                <div>
                  <p class="text-xs uppercase tracking-[.5em] text-[#d8c39a]">Petty Rich Bey</p>
                  <h3 class="logo mt-6 text-4xl leading-tight text-[#f1eee8] md:text-5xl">Tunnel of Love</h3>
                  <p class="mt-4 text-sm uppercase tracking-[.3em] text-[#d8c39a]">ACT I</p>
                  <p class="mt-2 text-xs uppercase tracking-[.25em] text-[#c9c6c0]">Masterpiece Theatre</p>
                  <p class="mt-8 text-xs uppercase tracking-[.35em] text-[#a9a39a]">19 tracks</p>
                </div>
              </div>
              <h3 class="logo mt-7 text-3xl">Tunnel of Love: ACT I</h3>
              <p class="mt-2 text-sm uppercase tracking-[.2em] text-[#d8c39a]">Masterpiece Theatre</p>
              <p class="mt-5 text-4xl font-semibold text-[#d8c39a]">$9.99</p>
              <ul class="mt-5 space-y-2 text-sm leading-6 text-[#c8c4bc]">
                <li>• Complete 19-track digital album</li>
                <li>• Secure checkout through PayPal</li>
                <li>• Private ZIP download after successful payment</li>
              </ul>
            </div>
            <button class="prb-button mt-8 w-full" data-product="PRB-TUNNEL-OF-LOVE-ACT-I">Buy full album · $9.99</button>
          </article>
        </div>

        <p id="checkout-status" class="mx-auto mt-8 min-h-6 max-w-2xl text-center text-sm text-[#d8c39a]" role="status" aria-live="polite"></p>
        <p class="mt-5 text-center text-xs leading-6 text-[#8e8981]">
          Official streaming release: Friday, February 12, 2027. Direct purchases are early-access digital downloads. The single and album are separate purchases.
        </p>
      </div>
    </section>

    <section class="border-t border-[#d8c39a]/15 bg-black/20 px-5 py-14 text-center md:px-8">
      <p class="prb-kicker text-xs">The curtain rises</p>
      <h2 class="logo mt-4 text-3xl md:text-4xl">Buy direct. Listen early.</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-7 text-[#bdb9b1]">
        Thank you for supporting independent music and Petty Rich Bey. Every direct purchase supports the artist.
      </p>
    </section>
  </main>

  <script define:vars={{ worker }}>

    const countdownTarget = new Date("2027-02-12T00:00:00-06:00").getTime();
    const countdownIds = {
      days: document.getElementById("tol-days"),
      hours: document.getElementById("tol-hours"),
      minutes: document.getElementById("tol-minutes"),
      seconds: document.getElementById("tol-seconds")
    };
    const countdownLabel = document.getElementById("tol-countdown-label");
    function updateTunnelCountdown() {
      const remaining = countdownTarget - Date.now();
      if (remaining <= 0) {
        document.getElementById("tol-countdown").innerHTML = '<div class="col-span-4 py-5 text-3xl font-semibold uppercase tracking-[.2em] text-[#d8c39a] md:text-5xl">OUT NOW</div>';
        countdownLabel.textContent = "The curtain is up · February 12, 2027";
        return;
      }
      countdownIds.days.textContent = Math.floor(remaining / 86400000);
      countdownIds.hours.textContent = Math.floor((remaining % 86400000) / 3600000).toString().padStart(2, "0");
      countdownIds.minutes.textContent = Math.floor((remaining % 3600000) / 60000).toString().padStart(2, "0");
      countdownIds.seconds.textContent = Math.floor((remaining % 60000) / 1000).toString().padStart(2, "0");
    }
    updateTunnelCountdown();
    setInterval(updateTunnelCountdown, 1000);

        const status = document.getElementById("checkout-status");

    async function captureReturnedOrder() {
      const params = new URLSearchParams(window.location.search);
      const orderID = params.get("token");
      if (!orderID || params.get("paypal") !== "return") return;

      status.textContent = "Confirming your payment securely…";
      try {
        const response = await fetch(`${worker}/paypal/capture-order`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ orderID })
        });
        const result = await response.json();
        if (!response.ok || !result.success || !result.download_url) {
          throw new Error(result.message || "Payment confirmation could not be completed.");
        }
        status.textContent = "Payment confirmed. Your download is starting…";
        window.location.replace(result.download_url);
      } catch (error) {
        status.textContent = error.message || "We couldn't confirm the payment. Please contact support before trying again.";
      }
    }

    document.querySelectorAll("[data-product]").forEach((button) => {
      button.addEventListener("click", async () => {
        const product = button.dataset.product;
        button.disabled = true;
        status.textContent = "Preparing your secure PayPal checkout…";
        try {
          const response = await fetch(`${worker}/paypal/create-order`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ product })
          });
          const result = await response.json();
          if (!response.ok || !result.success || !result.approval_url) {
            throw new Error(result.message || "Checkout is not ready yet. Please try again shortly.");
          }
          window.location.assign(result.approval_url);
        } catch (error) {
          status.textContent = error.message || "Unable to start checkout. Please try again.";
          button.disabled = false;
        }
      });
    });

    captureReturnedOrder();
  </script>
</BaseLayout>
