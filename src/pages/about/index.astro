---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="About | Petty Rich Bey">

  <section class="relative overflow-hidden px-8 py-24">

    <!-- Atmospheric Glow -->

    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,.18),transparent_60%)]"
    ></div>

    <div class="relative mx-auto max-w-7xl">


      <!-- About Header -->

      <div class="mx-auto max-w-4xl text-center">

        <p class="uppercase tracking-[0.45em] text-yellow-400">
          About
        </p>

        <h1 class="logo mt-5 text-6xl md:text-7xl">
          The Man Behind the World
        </h1>

        <p class="mt-8 text-lg leading-8 text-zinc-400">
          Music. Stories. Conversations. Visuals.
          One creative universe built across multiple forms of expression.
        </p>

      </div>


      <!-- Brand Introduction -->

      <div class="mt-20">

        <div
          class="grid overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 lg:grid-cols-2"
        >

          <!-- Brand Visual -->

          <div
            class="relative flex min-h-[520px] items-center justify-center overflow-hidden bg-zinc-950"
          >

            <div
              class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(124,58,237,.25),transparent_65%)]"
            ></div>

            <img
              src="/images/logos/logo.png"
              alt="Petty Rich Bey"
              class="relative z-10 w-[320px] object-contain"
            />

          </div>


          <!-- Introduction -->

          <div class="flex flex-col justify-center p-10 md:p-14">

            <p class="uppercase tracking-[0.35em] text-yellow-400">
              Petty Rich Bey
            </p>

            <h2 class="logo mt-5 text-5xl md:text-6xl">
              More Than a Name
            </h2>

            <p class="mt-6 text-lg leading-8 text-zinc-400">
              Petty Rich Bey is a creative identity built around storytelling,
              music, imagination, personality, and the freedom to explore
              different forms of expression.
            </p>

            <p class="mt-6 text-lg leading-8 text-zinc-400">
              From music and books to podcast conversations and visual
              projects, every piece is part of a larger creative universe.
            </p>

          </div>

        </div>

      </div>


      <!-- Creative Philosophy -->

      <div class="mt-24">

        <div class="mx-auto max-w-3xl text-center">

          <p class="uppercase tracking-[0.35em] text-yellow-400">
            The Philosophy
          </p>

          <h2 class="logo mt-4 text-5xl">
            Create Without Permission
          </h2>

          <p class="mt-6 text-lg leading-8 text-zinc-400">
            There is no single lane here.
            Music can become a story. A story can become a visual.
            A conversation can become a movement.
            The goal is simple: create work that feels authentic,
            memorable, and unmistakably its own.
          </p>

        </div>

      </div>


      <!-- Creative Universe -->

      <div class="mt-24">

        <div class="mb-10">

          <p class="uppercase tracking-[0.35em] text-yellow-400">
            The Universe
          </p>

          <h2 class="logo mt-4 text-5xl">
            Four Ways to Experience It
          </h2>

        </div>


        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">


          <!-- Music -->

          <a
            href="/music"
            class="group rounded-3xl border border-zinc-800 bg-zinc-900 p-8 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <p class="text-4xl">
              🎧
            </p>

            <h3 class="logo mt-6 text-3xl">
              Music
            </h3>

            <p class="mt-4 text-zinc-400">
              Albums, songs, and soundtracks created to tell stories
              through sound.
            </p>

            <div class="mt-8 font-semibold text-yellow-400">
              Enter Music →
            </div>

          </a>


          <!-- Books -->

          <a
            href="/books"
            class="group rounded-3xl border border-zinc-800 bg-zinc-900 p-8 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <p class="text-4xl">
              📚
            </p>

            <h3 class="logo mt-6 text-3xl">
              Books
            </h3>

            <p class="mt-4 text-zinc-400">
              Characters, worlds, and stories brought to life through
              the written word.
            </p>

            <div class="mt-8 font-semibold text-yellow-400">
              Enter the Library →
            </div>

          </a>


          <!-- Podcast -->

          <a
            href="/podcast"
            class="group rounded-3xl border border-zinc-800 bg-zinc-900 p-8 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <p class="text-4xl">
              🎙️
            </p>

            <h3 class="logo mt-6 text-3xl">
              Podcast
            </h3>

            <p class="mt-4 text-zinc-400">
              Real conversations, opinions, stories, and personalities
              without the filter.
            </p>

            <div class="mt-8 font-semibold text-yellow-400">
              Join the Conversation →
            </div>

          </a>


          <!-- Videos -->

          <a
            href="/videos"
            class="group rounded-3xl border border-zinc-800 bg-zinc-900 p-8 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <p class="text-4xl">
              🎬
            </p>

            <h3 class="logo mt-6 text-3xl">
              Videos
            </h3>

            <p class="mt-4 text-zinc-400">
              Visual stories, music videos, podcast moments,
              and creative projects.
            </p>

            <div class="mt-8 font-semibold text-yellow-400">
              Enter the Visual World →
            </div>

          </a>


        </div>

      </div>


      <!-- Closing Statement -->

      <div class="mt-24">

        <div
          class="rounded-3xl border border-yellow-400/20 bg-zinc-950 p-10 text-center md:p-16"
        >

          <p class="uppercase tracking-[0.4em] text-yellow-400">
            Petty Rich Bey
          </p>

          <h2 class="logo mt-5 text-4xl md:text-5xl">
            The Story Is Still Being Written.
          </h2>

          <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-zinc-400">
            New music. New stories. New conversations.
            New worlds waiting to be discovered.
          </p>

        </div>

      </div>


    </div>

  </section>

</BaseLayout>