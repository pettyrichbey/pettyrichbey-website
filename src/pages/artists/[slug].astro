---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { artists } from "../../data/artists";

export function getStaticPaths() {
  return artists.map((artist) => ({
    params: { slug: artist.slug },
    props: { artist },
  }));
}

const { artist } = Astro.props;
---

<BaseLayout title={`${artist.name} | Petty Rich Bey`}>
  <section class="relative overflow-hidden px-8 py-24">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,.2),transparent_60%)]"></div>

    <div class="relative mx-auto max-w-6xl">
      <div class="grid items-center gap-12 lg:grid-cols-[420px_1fr]">
        <div class="overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-950 shadow-2xl shadow-purple-950/20">
          <img
            src={artist.image}
            alt={`${artist.name} artwork`}
            class="aspect-square w-full object-cover"
          />
        </div>

        <div>
          <p class="uppercase tracking-[0.4em] text-yellow-400">{artist.role}</p>
          <h1 class="logo mt-5 text-6xl md:text-7xl">{artist.name}</h1>
          <p class="mt-8 max-w-2xl text-lg leading-8 text-zinc-400">{artist.bio}</p>
        </div>
      </div>

      <div class="mt-24">
        <p class="uppercase tracking-[0.35em] text-yellow-400">Music</p>
        <h2 class="logo mt-4 text-5xl">Listen</h2>

        <div class="mt-10 grid gap-8 md:grid-cols-2">
          {artist.releases.map((release) => (
            <article class="overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900">
              <img
                src={release.artwork}
                alt={`${artist.name} - ${release.title}`}
                class="aspect-square w-full object-cover"
              />
              <div class="p-7">
                <p class="text-xs uppercase tracking-[0.3em] text-yellow-400">
                  {release.type}
                </p>
                <h3 class="logo mt-3 text-3xl text-white">{release.title}</h3>
                <audio class="mt-6 w-full" controls preload="none">
                  <source src={release.audio} type="audio/mpeg" />
                  Your browser does not support the audio player.
                </audio>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="mt-24">
        <p class="uppercase tracking-[0.35em] text-yellow-400">Artwork</p>
        <h2 class="logo mt-4 text-5xl">Jungle Rose</h2>
        <div class="mt-10 max-w-md overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-950">
          <img
            src="/images/albums/jungle.png"
            alt={`${artist.name} - Jungle Rose artwork`}
            class="aspect-square w-full object-cover"
          />
        </div>
      </div>

      {artist.appearances.length > 0 && (
        <div class="mt-24">
          <p class="uppercase tracking-[0.35em] text-yellow-400">Collaborations</p>
          <h2 class="logo mt-4 text-5xl">Featured Appearances</h2>

          <div class="mt-10 grid gap-6 md:grid-cols-2">
            {artist.appearances.map((appearance) => (
              <a
                href={appearance.link}
                class="rounded-3xl border border-zinc-800 bg-zinc-900 p-7 transition hover:border-purple-500"
              >
                <p class="text-xs uppercase tracking-[0.28em] text-yellow-400">
                  Featured Appearance
                </p>
                <h3 class="logo mt-3 text-3xl text-white">{appearance.title}</h3>
                <p class="mt-3 text-zinc-400">{appearance.credit}</p>
                <span class="mt-5 inline-block text-sm uppercase tracking-[0.2em] text-purple-300">
                  Explore →
                </span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
