---
import BaseLayout from "../../layouts/BaseLayout.astro";

const videos = [
  {
    title: "Watermelon & Wine",
    file: "/videos/watermelon.mp4",
    category: "Music",
    project: "Heat Wave",
    description:
      "A warm, colorful visual moment from the Heat Wave era—summer energy, good vibes, and a little escape.",
    featured: true,
  },
  {
    title: "Twerk IT",
    file: "/videos/twerk.mp4",
    category: "Music",
    project: "Heat Wave",
    description:
      "Turn it up and let the summer energy take over. A visual companion to Twerk IT.",
    featured: false,
  },
  {
    title: "Cookout Vibes",
    file: "/videos/cookout.mp4",
    category: "Music",
    project: "Heat Wave",
    description:
      "A laid-back visual celebrating the food, energy, music, and summer spirit of the cookout.",
    featured: false,
  },
  {
    title: "Life Is Hard Enough feat. Aurea Hill",
    file: "/videos/life.mp4",
    category: "Music",
    project: "Petty Rich Bey",
    description:
      "The visual for Life Is Hard Enough, featuring Aurea Hill.",
    featured: false,
  },
  {
    title: "Let Them Try feat. Pilot & Bounty Killah",
    file: "/videos/let.mp4",
    category: "Music",
    project: "Petty Rich Bey",
    description:
      "The visual for Let Them Try, featuring Pilot and Bounty Killah.",
    featured: false,
  },
  {
    title: "Goofy Ass Bitch",
    file: "/videos/goofy.mp4",
    category: "Music",
    project: "Petty Rich Bey",
    description:
      "The visual for Goofy Ass Bitch.",
    featured: false,
  },
];

const featuredVideo = videos.find((video) => video.featured) ?? videos[0];
const libraryVideos = videos.filter((video) => video.file !== featuredVideo.file);
---

<BaseLayout title="Videos | Petty Rich Bey">

  <section class="relative overflow-hidden px-8 py-24">

    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,.18),transparent_60%)]"></div>

    <div class="relative mx-auto max-w-7xl">

      <!-- Header -->
      <div class="mx-auto max-w-4xl text-center">
        <p class="uppercase tracking-[0.45em] text-yellow-400">
          Visuals
        </p>

        <h1 class="logo mt-5 text-6xl md:text-7xl">
          The Visual World
        </h1>

        <p class="mt-8 text-lg leading-8 text-zinc-400">
          Music videos, visual moments, creative experiments, and the visual
          stories behind the Petty Rich Bey universe.
        </p>
      </div>

      <!-- Featured Visual -->
      <div class="mt-20">
        <div class="mb-8 flex items-end justify-between gap-6">
          <div>
            <p class="uppercase tracking-[0.35em] text-yellow-400">
              Featured Visual
            </p>
            <h2 class="logo mt-3 text-4xl md:text-5xl">
              {featuredVideo.title}
            </h2>
          </div>
          <p class="hidden text-sm uppercase tracking-[0.25em] text-zinc-500 md:block">
            {featuredVideo.project}
          </p>
        </div>

        <div class="overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-950 shadow-2xl shadow-purple-950/20">
          <video
            class="aspect-video w-full bg-black object-contain"
            controls
            preload="metadata"
            playsinline
          >
            <source src={featuredVideo.file} type="video/mp4" />
            Your browser does not support the video player.
          </video>

          <div class="border-t border-zinc-800 bg-zinc-950 p-8 md:p-10">
            <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.3em] text-yellow-400">
              <span>{featuredVideo.category}</span>
              <span class="text-zinc-700">•</span>
              <span>{featuredVideo.project}</span>
            </div>

            <p class="mt-5 max-w-3xl text-base leading-7 text-zinc-400">
              {featuredVideo.description}
            </p>
          </div>
        </div>
      </div>

      <!-- Video Library -->
      <div class="mt-24">
        <div class="mb-10">
          <p class="uppercase tracking-[0.35em] text-yellow-400">
            The Visual Library
          </p>
          <h2 class="logo mt-4 text-5xl">
            Watch & Explore
          </h2>
          <p class="mt-4 max-w-2xl text-zinc-400">
            Press play and explore the growing collection of visuals living
            directly on the Petty Rich Bey site.
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-2">
          {libraryVideos.map((video) => (
            <article class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 transition duration-300 hover:-translate-y-1 hover:border-purple-500">
              <video
                class="aspect-video w-full bg-black object-contain"
                controls
                preload="metadata"
                playsinline
              >
                <source src={video.file} type="video/mp4" />
                Your browser does not support the video player.
              </video>

              <div class="p-7 md:p-8">
                <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.28em] text-yellow-400">
                  <span>{video.category}</span>
                  <span class="text-zinc-700">•</span>
                  <span>{video.project}</span>
                </div>

                <h3 class="logo mt-4 text-3xl text-white">
                  {video.title}
                </h3>

                <p class="mt-4 leading-7 text-zinc-400">
                  {video.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Coming Soon -->
      <div class="mt-24 rounded-3xl border border-zinc-800 bg-zinc-950/70 p-10 text-center md:p-14">
        <p class="uppercase tracking-[0.35em] text-yellow-400">
          Coming Soon
        </p>

        <h2 class="logo mt-4 text-4xl md:text-5xl">
          More Visual Stories
        </h2>

        <p class="mx-auto mt-5 max-w-2xl leading-7 text-zinc-400">
          New music visuals, behind-the-scenes moments, podcast content, and
          cinematic projects will continue to expand the library.
        </p>
      </div>

    </div>
  </section>

</BaseLayout>
