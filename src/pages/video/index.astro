---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Videos | Petty Rich Bey">

  <section class="relative overflow-hidden px-8 py-24">

    <!-- Atmospheric Glow -->

    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,.18),transparent_60%)]"
    ></div>

    <div class="relative mx-auto max-w-7xl">

      <!-- Videos Header -->

      <div class="mx-auto max-w-4xl text-center">

        <p class="uppercase tracking-[0.45em] text-yellow-400">
          Visuals
        </p>

        <h1 class="logo mt-5 text-6xl md:text-7xl">
          The Visual World
        </h1>

        <p class="mt-8 text-lg leading-8 text-zinc-400">
          Music videos, visualizers, podcast moments, behind-the-scenes
          footage, and the visual stories behind the Petty Rich Bey universe.
        </p>

      </div>


      <!-- Featured Visual -->

      <div class="mt-20">

        <p class="mb-8 uppercase tracking-[0.35em] text-yellow-400">
          Featured Visual
        </p>

        <div
          class="group relative overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-950"
        >

          <!-- Purple Atmospheric Glow -->

          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(124,58,237,.25),transparent_65%)]"
          ></div>


          <!-- Logo -->

          <div class="relative flex min-h-[520px] items-center justify-center">

            <img
              src="/Images/logos/prb site logo.png"
              alt="Petty Rich Bey"
              class="relative z-10 w-[320px] object-contain transition duration-700 group-hover:scale-105"
            />

          </div>


          <!-- Featured Visual Information -->

          <div
            class="absolute bottom-0 left-0 z-20 w-full bg-gradient-to-t from-black via-black/80 to-transparent p-8 pt-24"
          >

            <p class="text-sm uppercase tracking-[0.35em] text-yellow-400">
              Featured Visual
            </p>

            <h2 class="logo mt-2 text-4xl text-white">
              Petty Rich Bey
            </h2>

            <p class="mt-2 max-w-xl text-sm text-zinc-300">
              Enter the visual world of Petty Rich Bey.
              More visual projects coming soon.
            </p>

          </div>

        </div>

      </div>


      <!-- Video Categories -->

      <div class="mt-24">

        <div class="mb-10">

          <p class="uppercase tracking-[0.35em] text-yellow-400">
            The Visual Library
          </p>

          <h2 class="logo mt-4 text-5xl">
            Watch & Explore
          </h2>

        </div>


        <div class="grid gap-8 md:grid-cols-2">


          <!-- Music Videos -->

          <article
            class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <div
              class="flex aspect-video items-center justify-center bg-zinc-950"
            >

              <span class="text-5xl">
                ▶
              </span>

            </div>

            <div class="p-8">

              <p class="text-sm uppercase tracking-[0.3em] text-yellow-400">
                Music
              </p>

              <h3 class="logo mt-4 text-3xl">
                Music Videos
              </h3>

              <p class="mt-4 text-zinc-400">
                Visual stories inspired by the music of Petty Rich Bey.
              </p>

              <div class="mt-8 font-semibold text-yellow-400">
                Watch Music Videos →
              </div>

            </div>

          </article>


          <!-- Podcast -->

          <article
            class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <div
              class="flex aspect-video items-center justify-center bg-zinc-950"
            >

              <span class="text-5xl">
                🎙️
              </span>

            </div>

            <div class="p-8">

              <p class="text-sm uppercase tracking-[0.3em] text-yellow-400">
                Podcast
              </p>

              <h3 class="logo mt-4 text-3xl">
                Podcast Moments
              </h3>

              <p class="mt-4 text-zinc-400">
                Clips, conversations, debates, and memorable moments
                from ANE Podcast.
              </p>

              <div class="mt-8 font-semibold text-yellow-400">
                Watch Podcast Clips →
              </div>

            </div>

          </article>


          <!-- Behind the Scenes -->

          <article
            class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <div
              class="flex aspect-video items-center justify-center bg-zinc-950"
            >

              <span class="text-5xl">
                🎬
              </span>

            </div>

            <div class="p-8">

              <p class="text-sm uppercase tracking-[0.3em] text-yellow-400">
                Behind the Scenes
              </p>

              <h3 class="logo mt-4 text-3xl">
                Behind the Mic
              </h3>

              <p class="mt-4 text-zinc-400">
                Go behind the scenes of the creative process,
                recording sessions, and projects.
              </p>

              <div class="mt-8 font-semibold text-yellow-400">
                Go Behind the Scenes →
              </div>

            </div>

          </article>


          <!-- Creative Projects -->

          <article
            class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <div
              class="flex aspect-video items-center justify-center bg-zinc-950"
            >

              <span class="text-5xl">
                ✨
              </span>

            </div>

            <div class="p-8">

              <p class="text-sm uppercase tracking-[0.3em] text-yellow-400">
                Creative Projects
              </p>

              <h3 class="logo mt-4 text-3xl">
                Visual Stories
              </h3>

              <p class="mt-4 text-zinc-400">
                Experimental visuals, storytelling, and creative
                projects from the Petty Rich Bey universe.
              </p>

              <div class="mt-8 font-semibold text-yellow-400">
                Explore Visual Stories →
              </div>

            </div>

          </article>


        </div>

      </div>

    </div>

  </section>

</BaseLayout>