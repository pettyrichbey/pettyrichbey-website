---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Petty Rich Bey | The Creative House"
  description="The official home of Petty Rich Bey — music, stories, conversations, publishing and Bey Mirror Media."
>
  <section class="prb-cinema relative isolate min-h-[88vh] overflow-hidden border-b border-[var(--prb-line)]">
    <div class="prb-cinema-haze absolute inset-0 -z-20"></div>
    <div class="prb-filmgrain absolute inset-0 -z-10"></div>
    <div class="relative mx-auto grid min-h-[88vh] max-w-7xl items-center gap-10 px-6 py-20 md:px-10 lg:grid-cols-[1.1fr_.9fr]">
      <div class="max-w-3xl">
        <div class="prb-studio-mark mb-9 inline-flex items-center gap-3"><span class="prb-star">✦</span><span>A Bey Mirror Media Production</span><span class="prb-star">✦</span></div>
        <p class="mb-4 text-[10px] uppercase tracking-[.55em] text-[var(--prb-champagne)]">A creative picture in glorious noir</p>
        <h1 class="prb-display prb-metal text-7xl leading-[.82] sm:text-8xl md:text-9xl xl:text-[9rem]">Petty<br/><span class="prb-italic">Rich Bey</span></h1>
        <div class="my-8 flex items-center gap-4"><span class="h-px w-16 bg-[var(--prb-champagne)]"></span><span class="text-[10px] uppercase tracking-[.4em] text-[var(--prb-champagne)]">Starring in his own story</span><span class="h-px w-16 bg-[var(--prb-champagne)]"></span></div>
        <p class="max-w-xl font-serif text-xl italic leading-8 text-[#e8e3dc]/80 md:text-2xl">“Where the lights are low, the stories are larger, and the night belongs to the unforgettable.”</p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/music" class="prb-button">Now showing · Music <span aria-hidden="true">✦</span></a>
          <a href="/about" class="prb-button prb-button-outline">The story behind the name</a>
        </div>
        <p class="mt-14 text-[9px] uppercase tracking-[.42em] text-[var(--prb-muted)]">Artist · Author · Creator · The Main Attraction</p>
      </div>
      <div class="relative mx-auto w-full max-w-[450px]">
        <div class="prb-marquee-frame relative flex aspect-[4/5] items-center justify-center overflow-hidden p-8">
          <div class="prb-marquee-inner absolute inset-4"></div>
          <div class="relative z-10 flex h-full w-full flex-col items-center justify-center text-center">
            <p class="text-[10px] uppercase tracking-[.5em] text-[var(--prb-champagne)]">The feature presentation</p>
            <img src="/images/logos/logo.png" alt="Petty Rich Bey crowned monogram" class="my-7 w-[78%] object-contain drop-shadow-[0_12px_30px_rgba(255,255,255,.16)]"/>
            <div class="prb-rule my-2 w-3/4"></div>
            <p class="mt-4 font-serif text-3xl italic text-[#eee8df]">A name in lights.</p>
            <p class="mt-3 text-[9px] uppercase tracking-[.42em] text-[var(--prb-champagne)]">Bey Mirror Media · Est. in imagination</p>
          </div>
        </div>
        <div class="mt-5 text-center text-[9px] uppercase tracking-[.5em] text-[var(--prb-muted)]">Presented in black · white · and a little gold</div>
      </div>
    </div>
    <div class="prb-filmstrip absolute bottom-0 left-0 right-0"></div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-24 md:px-10">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
      <div><p class="prb-kicker text-xs">Coming attractions</p><h2 class="prb-display mt-4 text-4xl md:text-6xl">The next <span class="prb-italic text-[var(--prb-champagne)]">picture.</span></h2></div>
      <p class="max-w-md text-sm leading-7 text-[var(--prb-muted)]">Two dates. One story. Get ready for the first taste of the Tunnel of Love era.</p>
    </div>
    <div class="grid gap-6 lg:grid-cols-2">
      <article class="prb-panel group overflow-hidden rounded-2xl">
        <div class="grid h-full sm:grid-cols-[.82fr_1fr]">
          <div class="relative min-h-[280px] overflow-hidden bg-[#26121b]">
            <img src="https://prb-digital-delivery.pettyrichbey.workers.dev/media/intoxicated-thumbnail" alt="INTOXICATED single artwork" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"/>
            <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent"></div>
            <span class="absolute bottom-5 left-5 text-[10px] uppercase tracking-[.35em] text-white/80">Lead single</span>
          </div>
          <div class="flex flex-col justify-center p-8 md:p-10">
            <p class="prb-kicker text-[10px]">January 15, 2027</p>
            <h3 class="prb-display mt-4 text-4xl md:text-5xl">INTOXICATED</h3>
            <p class="mt-4 text-sm leading-7 text-[var(--prb-muted)]">The first taste of Tunnel of Love: ACT I. Experience the single before its official release.</p>
            <a href="/tunnel-of-love" class="mt-8 inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-[.22em] text-[var(--prb-champagne)]">Discover the single <span>↗</span></a>
          </div>
        </div>
      </article>
      <article class="prb-panel flex flex-col justify-between overflow-hidden rounded-2xl p-8 md:p-10">
        <div>
          <p class="prb-kicker text-[10px]">The full album · February 12, 2027</p>
          <h3 class="prb-display mt-5 text-4xl leading-tight md:text-5xl">Tunnel of Love:<br/><span class="prb-italic text-[var(--prb-champagne)]">ACT I</span></h3>
          <p class="mt-5 text-xs uppercase tracking-[.32em] text-[var(--prb-champagne)]">Masterpiece Theatre</p>
          <p class="mt-6 max-w-md text-sm leading-7 text-[var(--prb-muted)]">A beautiful, seductive carnival of love, desire, and late-night emotion—with shadows waiting just beyond the lights.</p>
        </div>
        <a href="/tunnel-of-love" class="mt-10 inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-[.22em] text-[var(--prb-champagne)]">Enter the experience <span>↗</span></a>
      </article>
    </div>
  </section>

  <section class="border-y border-[var(--prb-line)] bg-[#080808] py-24">
    <div class="mx-auto max-w-7xl px-6 md:px-10">
      <div class="mx-auto max-w-2xl text-center"><p class="prb-kicker text-xs">Beyond the silver screen</p><h2 class="prb-display mt-4 text-4xl md:text-6xl">A world of its <span class="prb-italic text-[var(--prb-champagne)]">own.</span></h2><p class="mt-6 text-sm leading-7 text-[var(--prb-muted)]">Explore the projects, platforms, and stories that live under the Bey Mirror Media umbrella.</p></div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-[var(--prb-line)] bg-[var(--prb-line)] sm:grid-cols-2 lg:grid-cols-4">
        <a href="/peoples-report" class="prb-tile"><span>01 / News & culture</span><h3>People's Report</h3><p>Stories and conversations that matter.</p><b>Explore ↗</b></a>
        <a href="/podcast" class="prb-tile"><span>02 / On air</span><h3>ANE Radio</h3><p>Absolutely No Excuses and original programming.</p><b>Listen in ↗</b></a>
        <a href="/music" class="prb-tile"><span>03 / Sound</span><h3>Music</h3><p>Singles, albums, releases, and exclusives.</p><b>Discover ↗</b></a>
        <a href="/books" class="prb-tile"><span>04 / Written worlds</span><h3>Books</h3><p>Fiction, imagination, and stories in print.</p><b>Read more ↗</b></a>
        <a href="/videos" class="prb-tile"><span>05 / Moving image</span><h3>Video</h3><p>Visuals, trailers, and behind-the-scenes.</p><b>Watch ↗</b></a>
        <a href="/journal" class="prb-tile"><span>06 / The journal</span><h3>Journal</h3><p>Notes, perspectives, and creative dispatches.</p><b>Read ↗</b></a>
        <a href="/sponsors" class="prb-tile"><span>07 / Partnerships</span><h3>Sponsors</h3><p>Collaborate with Bey Mirror Media.</p><b>Partner ↗</b></a>
        <a href="/vip" class="prb-tile"><span>08 / Inner circle</span><h3>PRB VIP Club</h3><p>First to hear it. First to see it. First to get it.</p><b>Get access ↗</b></a>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden px-6 py-24 text-center md:px-10">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_50%_100%,rgba(190,190,190,.07),transparent_65%)]"></div>
    <p class="prb-kicker text-xs">Bey Mirror Media</p>
    <h2 class="prb-display mx-auto mt-5 max-w-4xl text-4xl leading-tight md:text-6xl">Independent vision.<br/><span class="prb-italic text-[var(--prb-champagne)]">Unmistakable presence.</span></h2>
    <a href="/about" class="prb-button mt-10">Discover the story</a>
  </section>
</BaseLayout>
