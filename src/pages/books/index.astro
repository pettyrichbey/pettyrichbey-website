---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Books | Petty Rich Bey">

  <section class="relative overflow-hidden px-8 py-24">

    <!-- Atmospheric Glow -->

    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,.18),transparent_60%)]"
    ></div>

    <div class="relative mx-auto max-w-7xl">

      <!-- Books Header -->

      <div class="mx-auto max-w-3xl text-center">

        <p class="uppercase tracking-[0.45em] text-yellow-400">
          Books
        </p>

        <h1 class="logo mt-5 text-6xl md:text-7xl">
          Stories Beyond the Sound
        </h1>

        <p class="mt-8 text-lg leading-8 text-zinc-400">
          Worlds, characters, and stories created by P. R. Bey.
          Enter the pages and discover another side of the universe.
        </p>

      </div>


      <!-- Featured Book -->

      <div class="mt-20">

        <p class="mb-8 uppercase tracking-[0.35em] text-yellow-400">
          Featured Book
        </p>

        <div
          class="group grid overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 lg:grid-cols-2"
        >

          <!-- Book Artwork -->

          <div class="overflow-hidden bg-zinc-950">

            <img
              src="/Images/books/whispers2.png"
              alt="Whispers After Dark by P. R. Bey"
              class="w-full object-cover transition duration-700 group-hover:scale-105"
            />

          </div>


          <!-- Book Information -->

          <div class="flex flex-col justify-center p-10 md:p-14">

            <p class="uppercase tracking-[0.35em] text-yellow-400">
              P. R. Bey
            </p>

            <h2 class="logo mt-5 text-5xl md:text-6xl">
              Whispers After Dark
            </h2>

            <p class="mt-6 text-lg leading-8 text-zinc-400">
              A story waiting to pull you into the darkness.
              Discover the latest work from P. R. Bey.
            </p>

            <div class="mt-8 text-sm text-zinc-500">
              2026
            </div>

            <a
              href="https://www.amazon.com/author/prbey"
              class="mt-10 inline-block w-fit rounded-xl bg-purple-700 px-8 py-4 font-semibold text-white transition duration-300 hover:-translate-y-1 hover:bg-purple-600 hover:shadow-[0_0_25px_rgba(124,58,237,.4)]"
            >
              Explore Book →
            </a>

          </div>

        </div>

      </div>


      <!-- The Library -->

      <div class="mt-24">

        <div class="mb-10">

          <p class="uppercase tracking-[0.35em] text-yellow-400">
            The Library
          </p>

          <h2 class="logo mt-4 text-5xl">
            Stories & Worlds
          </h2>

        </div>


        <!-- Book Grid -->

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">


          <!-- Majesty's Heaven -->

          <article
            class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <div
              class="flex aspect-[4/5] items-center justify-center overflow-hidden bg-zinc-950"
            >

              <p class="text-sm uppercase tracking-[0.3em] text-zinc-600">
                Cover Coming Soon
              </p>

            </div>

            <div class="p-6">

              <p class="text-sm uppercase tracking-[0.3em] text-yellow-400">
                Novel
              </p>

              <h3 class="logo mt-4 text-3xl">
                Majesty's Heaven
              </h3>

              <p class="mt-4 text-zinc-400">
                Enter a world of characters, conflict, and imagination.
              </p>

              <div class="mt-8 font-semibold text-yellow-400">
                Coming Soon →
              </div>

            </div>

          </article>


          <!-- Sangroux Chronicles -->

          <article
            class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <div
              class="flex aspect-[4/5] items-center justify-center overflow-hidden bg-zinc-950"
            >

              <p class="text-sm uppercase tracking-[0.3em] text-zinc-600">
                Cover Coming Soon
              </p>

            </div>

            <div class="p-6">

              <p class="text-sm uppercase tracking-[0.3em] text-yellow-400">
                Series
              </p>

              <h3 class="logo mt-4 text-3xl">
                Sangroux Chronicles
              </h3>

              <p class="mt-4 text-zinc-400">
                A continuing story from the world of P. R. Bey.
              </p>

              <div class="mt-8 font-semibold text-yellow-400">
                Coming Soon →
              </div>

            </div>

          </article>


          <!-- Wolfsbane -->

          <article
            class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <div
              class="flex aspect-[4/5] items-center justify-center overflow-hidden bg-zinc-950"
            >

              <p class="text-sm uppercase tracking-[0.3em] text-zinc-600">
                Cover Coming Soon
              </p>

            </div>

            <div class="p-6">

              <p class="text-sm uppercase tracking-[0.3em] text-yellow-400">
                Fiction
              </p>

              <h3 class="logo mt-4 text-3xl">
                Wolfsbane
              </h3>

              <p class="mt-4 text-zinc-400">
                A darker story from the P. R. Bey universe.
              </p>

              <div class="mt-8 font-semibold text-yellow-400">
                Coming Soon →
              </div>

            </div>

          </article>


        </div>

      </div>

    </div>

  </section>

</BaseLayout>