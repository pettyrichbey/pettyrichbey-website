---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="PRB VIP Club | Petty Rich Bey">
  <section class="relative overflow-hidden px-8 py-24">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,.20),transparent_60%)]"></div>

    <div class="relative mx-auto max-w-7xl">
      <div class="mx-auto max-w-4xl text-center">
        <p class="uppercase tracking-[0.4em] text-yellow-400">PRB VIP CLUB</p>
        <h1 class="logo mt-6 text-6xl leading-none md:text-8xl">
          First to hear it. First to see it. First to get it.
        </h1>
        <p class="mx-auto mt-8 max-w-3xl text-lg leading-8 text-zinc-300">
          Step inside the world of Petty Rich Bey and get closer to the music,
          visuals, stories, and experiences before they reach the public.
        </p>
      </div>

      <div class="mt-16 grid gap-8 lg:grid-cols-2">
        <article class="rounded-3xl border border-yellow-400/30 bg-zinc-900 p-8 shadow-2xl md:p-10">
          <p class="text-sm uppercase tracking-[0.3em] text-yellow-400">VIP</p>
          <h2 class="logo mt-4 text-5xl">$5.99 / month</h2>
          <p class="mt-5 text-zinc-400">The core PRB VIP experience for fans who want to be first.</p>

          <ul class="mt-8 space-y-4 text-zinc-300">
            <li>🎵 Early access to new music</li>
            <li>🎬 Early access to videos</li>
            <li>🖼️ Exclusive artwork and posters</li>
            <li>🎬 Behind-the-scenes content</li>
            <li>🎤 Behind-the-music access</li>
            <li>🎧 Private listening parties and VIP experiences</li>
            <li>👕 Early access to merchandise drops</li>
            <li>🗳️ Opportunities to vote on select creative decisions</li>
          </ul>

          <!-- Add the PayPal subscription link after the plan is created in PayPal. -->
          <a
            href="#paypal-vip"
            class="mt-10 inline-flex w-full justify-center rounded-xl bg-purple-700 px-8 py-4 font-semibold text-white transition duration-300 hover:-translate-y-1 hover:bg-purple-600"
          >
            Join VIP — $5.99/month
          </a>
        </article>

        <article class="rounded-3xl border border-purple-500/40 bg-zinc-900 p-8 shadow-2xl md:p-10">
          <p class="text-sm uppercase tracking-[0.3em] text-yellow-400">VIP+</p>
          <h2 class="logo mt-4 text-5xl">$12.99 / month</h2>
          <p class="mt-5 text-zinc-400">The deeper-access tier for supporters who want even more of the PRB universe.</p>

          <ul class="mt-8 space-y-4 text-zinc-300">
            <li>✨ Everything included with VIP</li>
            <li>🎶 Members-only music releases</li>
            <li>🎁 VIP merchandise discounts</li>
            <li>🛍️ Access to limited VIP items</li>
            <li>🎥 Deeper behind-the-scenes access</li>
            <li>🎤 Enhanced access to private experiences</li>
          </ul>

          <!-- Add the PayPal subscription link after the plan is created in PayPal. -->
          <a
            href="#paypal-vip-plus"
            class="mt-10 inline-flex w-full justify-center rounded-xl border border-yellow-400 px-8 py-4 font-semibold text-yellow-400 transition hover:bg-yellow-400 hover:text-black"
          >
            Join VIP+ — $12.99/month
          </a>
        </article>
      </div>

      <div class="mx-auto mt-16 max-w-4xl rounded-3xl border border-zinc-800 bg-zinc-950/70 p-8 text-center md:p-12">
        <p class="uppercase tracking-[0.3em] text-yellow-400">Support the Creative Universe</p>
        <h2 class="logo mt-4 text-4xl md:text-5xl">Your support helps keep the music moving.</h2>
        <p class="mt-5 leading-8 text-zinc-400">
          Prefer a one-time contribution instead of a membership? You can support
          Petty Rich Bey directly through Cash App while PayPal purchase links are
          being added to the store.
        </p>
        <a
          href="https://cash.app/$pettyrichbey"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex rounded-xl bg-yellow-400 px-8 py-4 font-semibold text-black transition hover:-translate-y-1"
        >
          Support via Cash App →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
