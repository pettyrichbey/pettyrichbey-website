---
import BaseLayout from "../layouts/BaseLayout.astro";
import AlbumCard from "../components/AlbumCard.astro";
import { albums } from "../data/albums";
---

<BaseLayout title="Music | Petty Rich Bey">

<section class="py-24">

<div class="mx-auto max-w-7xl px-8">

<div class="mb-20 text-center">

<p class="uppercase tracking-[0.4em] text-yellow-400">

Music

</p>

<h1 class="logo mt-6 text-6xl">

The Soundtrack

</h1>

<p class="mx-auto mt-8 max-w-3xl text-lg leading-8 text-zinc-400">

Every song tells a story.
Every album represents a different chapter
in the Petty Rich Bey universe.

</p>

</div>

<div class="grid gap-10 lg:grid-cols-3">

{albums.map((album) => (

<AlbumCard album={album} />

))}

</div>

</div>

</section>

</BaseLayout>