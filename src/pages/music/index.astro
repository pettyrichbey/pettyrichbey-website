---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { albums } from "../../data/albums";
import AlbumCard from "../../components/AlbumCard.astro";
---

<BaseLayout title="Music | Petty Rich Bey">

  <section class="relative overflow-hidden px-8 py-24">

    <!-- Atmospheric Glow -->

    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(190,190,190,.10),transparent_60%)]"
    ></div>

    <div class="relative mx-auto max-w-7xl">

      <!-- Music Header -->

      <div class="mx-auto max-w-3xl text-center">

        <p class="uppercase tracking-[0.45em] text-[#c8b58b]">
          Music
        </p>

        <h1 class="logo mt-5 text-6xl md:text-7xl">
          The Soundtrack
        </h1>

        <p class="mt-8 text-lg leading-8 text-zinc-400">
          Every song tells a story.
          Every album represents a different chapter
          in the Petty Rich Bey universe.
        </p>

      </div>

      <!-- Vintage music room -->
      <div class="mx-auto mt-14 grid max-w-5xl items-center gap-6 md:grid-cols-3">
        <div class="music-object rounded-3xl border border-zinc-700 bg-gradient-to-br from-zinc-800 via-zinc-950 to-black p-6 text-center shadow-2xl">
          <p class="mb-5 text-[10px] uppercase tracking-[.3em] text-[#c8b58b]">The listening room</p>
          <div class="mx-auto flex aspect-square max-w-44 items-center justify-center rounded-full border-[10px] border-zinc-700 bg-[repeating-radial-gradient(circle,#101010_0_2px,#303030_3px_4px)] shadow-[0_15px_35px_#000]">
            <div class="flex h-14 w-14 items-center justify-center rounded-full border border-[#c8b58b]/60 bg-[#171717] text-[10px] font-bold tracking-widest text-[#d8c9a7]">PRB</div>
          </div>
          <p class="mt-5 font-serif text-xl text-zinc-200">Vinyl &amp; soul</p>
        </div>
        <div class="music-object rounded-3xl border border-zinc-700 bg-gradient-to-br from-zinc-800 via-zinc-950 to-black p-6 text-center shadow-2xl">
          <p class="mb-5 text-[10px] uppercase tracking-[.3em] text-[#c8b58b]">The instrument</p>
          <div class="mx-auto flex h-44 items-center justify-center">
            <svg viewBox="0 0 160 210" class="h-full w-auto drop-shadow-[0_12px_12px_rgba(0,0,0,.8)]" role="img" aria-label="Elegant vintage violin illustration">
              <path d="M80 12 L80 72 M80 72 C48 55 34 79 46 103 C21 126 40 165 67 150 C75 145 77 133 80 125 C83 133 85 145 93 150 C120 165 139 126 114 103 C126 79 112 55 80 72Z" fill="#754b2b" stroke="#c8b58b" stroke-width="3"/>
              <path d="M80 12 Q63 3 72 0 Q80 8 88 0 Q97 3 80 12Z" fill="#a87943" stroke="#c8b58b" stroke-width="2"/>
              <path d="M80 13 L80 187 M74 12 L74 69 M86 12 L86 69" stroke="#e2d0ad" stroke-width="1.4"/>
              <path d="M48 103 Q57 93 66 103 Q58 112 48 103 M112 103 Q103 93 94 103 Q102 112 112 103" fill="none" stroke="#d9c29a" stroke-width="2"/>
              <path d="M61 166 Q80 157 99 166 L95 176 Q80 181 65 176Z" fill="#c8b58b"/>
              <path d="M70 184 L90 184 L95 197 L65 197Z" fill="#6c4529" stroke="#c8b58b" stroke-width="2"/>
            </svg>
          </div>
          <p class="mt-2 font-serif text-xl text-zinc-200">Strings &amp; elegance</p>
        </div>
        <div class="music-object rounded-3xl border border-zinc-700 bg-gradient-to-br from-zinc-800 via-zinc-950 to-black p-6 text-center shadow-2xl">
          <p class="mb-5 text-[10px] uppercase tracking-[.3em] text-[#c8b58b]">Now tuning</p>
          <div class="mx-auto max-w-56 rounded-2xl border-[7px] border-zinc-700 bg-gradient-to-b from-zinc-600 to-zinc-950 p-4 shadow-[0_18px_35px_#000]">
            <div class="rounded-lg border border-zinc-500 bg-[#101010] p-4">
              <div class="flex justify-between text-[9px] tracking-[.2em] text-[#c8b58b]"><span>PRB</span><span>AM · FM</span></div>
              <div class="mt-4 h-7 rounded border border-zinc-700 bg-gradient-to-r from-zinc-900 via-zinc-600 to-zinc-900"></div>
              <div class="mt-4 flex items-center justify-between">
                <div class="h-12 w-12 rounded-full border-4 border-zinc-500 bg-[radial-gradient(circle,#111_0_25%,#777_27%,#222_60%,#080808_70%)]"></div>
                <div class="h-9 w-9 rounded-full border-4 border-zinc-500 bg-[radial-gradient(circle_at_35%_30%,#aaa,#333_65%)]"></div>
              </div>
            </div>
          </div>
          <p class="mt-5 font-serif text-xl text-zinc-200">Radio classics</p>
        </div>
      </div>
      <p class="mt-8 text-center text-[10px] uppercase tracking-[.35em] text-zinc-500">A little old soul · A little new sound · All Petty Rich Bey</p>

      <!-- Artists & Collaborators -->

      <div class="mt-16">

        <div class="overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-950 p-8 md:p-10">

          <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">

            <div class="max-w-2xl">

              <p class="uppercase tracking-[0.35em] text-[#c8b58b]">
                Artists & Collaborators
              </p>

              <h2 class="logo mt-4 text-4xl md:text-5xl">
                Meet the Artists
              </h2>

              <p class="mt-5 leading-7 text-zinc-400">
                Discover the independent artists and collaborators who bring
                the Petty Rich Bey creative universe to life.
              </p>

            </div>

            <a
              href="/artists"
              class="shrink-0 rounded-xl border border-[#c8b58b] px-7 py-4 font-semibold text-[#c8b58b] transition duration-300 hover:bg-[#c8b58b] hover:text-black"
            >
              Explore Artists →
            </a>

          </div>

        </div>

      </div>

      <!-- Featured Project -->

      <div class="mt-20">

        <p class="mb-8 uppercase tracking-[0.35em] text-[#c8b58b]">
          Featured Project
        </p>

        {
          albums
            .filter((album) => album.featured)
            .map((album) => (
              <a
                href={album.link}
                class="group grid overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 lg:grid-cols-2"
              >

                <!-- Album Artwork -->

                <div class="overflow-hidden">

                  <img
                    src={album.image}
                    alt={`${album.title} album cover`}
                    class="aspect-square w-full object-cover transition duration-700 group-hover:scale-105"
                  />

                </div>

                <!-- Album Information -->

                <div class="flex flex-col justify-center p-10 md:p-14">

                  <p class="uppercase tracking-[0.35em] text-[#c8b58b]">
                    {album.type}
                  </p>

                  <h2 class="logo mt-5 text-5xl md:text-6xl">
                    {album.title}
                  </h2>

                  <p class="mt-6 text-lg leading-8 text-zinc-400">
                    {album.description}
                  </p>

                  <div class="mt-8 flex gap-6 text-sm text-zinc-500">

                    <span>{album.year}</span>

                    <span>•</span>

                    <span>{album.tracks} Tracks</span>

                  </div>

                  <div
                    class="mt-10 font-semibold text-[#c8b58b] transition-transform duration-300 group-hover:translate-x-2"
                  >
                    Explore {album.title} →
                  </div>

                </div>

              </a>
            ))
        }

      </div>

      <!-- Catalog -->

      <div class="mt-24">

        <div class="mb-10">

          <p class="uppercase tracking-[0.35em] text-[#c8b58b]">
            The Catalog
          </p>

          <h2 class="logo mt-4 text-5xl">
            More Releases
          </h2>

        </div>

        <!-- Album Cards -->

        <div class="grid gap-8 md:grid-cols-2">

          {
            albums
              .filter((album) => !album.featured)
              .map((album) => (
                <AlbumCard album={album} />
              ))
          }

        </div>

      </div>

      <!-- Nostalgia -->

      <div class="mt-24">

        <div class="mb-10 max-w-3xl">

          <p class="uppercase tracking-[0.35em] text-[#c8b58b]">
            From the Vault
          </p>

          <h2 class="logo mt-4 text-5xl md:text-6xl">
            Nostalgia
          </h2>

          <p class="mt-5 text-lg leading-8 text-zinc-400">
            Old records, forgotten moments, and songs worth remembering.
            Step into the vault and rediscover some of the music that helped
            shape the Petty Rich Bey universe.
          </p>

        </div>

        <div class="grid gap-6 md:grid-cols-2">

          <article class="rounded-3xl border border-zinc-800 bg-zinc-950 p-7 md:p-8">
            <p class="text-sm uppercase tracking-[0.25em] text-[#c8b58b]">
              Nostalgia Premiere
            </p>
            <h3 class="mt-3 text-2xl font-semibold">
              Boombx
            </h3>
            <p class="mt-2 text-zinc-400">
              Petty Rich Bey Feat. Epidemic & Fale
            </p>
            <audio class="mt-6 w-full" controls preload="none">
              <source src="/audio/nostalgia/boombx.mp3" type="audio/mpeg" />
              Your browser does not support the audio player.
            </audio>
          </article>

          <article class="rounded-3xl border border-zinc-800 bg-zinc-950 p-7 md:p-8">
            <p class="text-sm uppercase tracking-[0.25em] text-[#c8b58b]">
              From the Vault
            </p>
            <h3 class="mt-3 text-2xl font-semibold">
              Never Broke Up
            </h3>
            <audio class="mt-6 w-full" controls preload="none">
              <source src="/audio/nostalgia/never.mp3" type="audio/mpeg" />
              Your browser does not support the audio player.
            </audio>
          </article>

          <article class="rounded-3xl border border-zinc-800 bg-zinc-950 p-7 md:p-8">
            <p class="text-sm uppercase tracking-[0.25em] text-[#c8b58b]">
              From the Vault
            </p>
            <h3 class="mt-3 text-2xl font-semibold">
              Something Like That
            </h3>
            <audio class="mt-6 w-full" controls preload="none">
              <source src="/audio/nostalgia/something.mp3" type="audio/mpeg" />
              Your browser does not support the audio player.
            </audio>
          </article>

          <article class="rounded-3xl border border-zinc-800 bg-zinc-950 p-7 md:p-8">
            <p class="text-sm uppercase tracking-[0.25em] text-[#c8b58b]">
              From the Vault
            </p>
            <h3 class="mt-3 text-2xl font-semibold">
              Wiggle It
            </h3>
            <audio class="mt-6 w-full" controls preload="none">
              <source src="/audio/nostalgia/wiggle.mp3" type="audio/mpeg" />
              Your browser does not support the audio player.
            </audio>
          </article>

        </div>

      </div>

    </div>

  </section>

</BaseLayout>