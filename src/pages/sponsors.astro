---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sponsors | Petty Rich Bey"
  description="Official sponsor and partner page for Petty Rich Bey and Bey Mirror Media. Discover featured partners, exclusive codes, and direct links."
>
  <section class="relative overflow-hidden px-6 py-24 md:px-8">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,.22),transparent_58%)]"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-yellow-400/60 to-transparent"></div>

    <div class="relative mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="uppercase tracking-[0.45em] text-yellow-400">Partners</p>
        <h1 class="logo mt-5 text-6xl md:text-7xl">Sponsors &amp; Partners</h1>
        <p class="mt-8 text-lg leading-8 text-zinc-400">
          Brands I believe are worth putting in front of the Bey Mirror Media community.
          Shop through my links, use my codes, and support the partners supporting the work.
        </p>
      </div>

      <div class="mt-20 grid gap-8 lg:grid-cols-2">
        <!-- The Loaded Tea Shop -->
        <article class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 shadow-2xl transition duration-300 hover:-translate-y-2 hover:border-pink-500/70">
          <div class="relative overflow-hidden bg-gradient-to-br from-purple-950 via-zinc-950 to-pink-950 p-10">
            <div class="absolute -right-20 -top-20 h-48 w-48 rounded-full bg-pink-500/20 blur-3xl"></div>
            <div class="absolute -bottom-20 -left-20 h-48 w-48 rounded-full bg-purple-500/20 blur-3xl"></div>
            <div class="relative">
              <p class="text-5xl">🧋</p>
              <p class="mt-6 uppercase tracking-[0.3em] text-pink-300">Featured Partner</p>
              <h2 class="logo mt-3 text-4xl md:text-5xl">The Loaded Tea Shop</h2>
              <p class="mt-5 max-w-xl text-zinc-300">
                Colorful loaded teas made for flavor, energy, and a little fun. Check out the full collection and shop using my personal partner code.
              </p>
            </div>
          </div>

          <div class="p-8 md:p-10">
            <div class="rounded-2xl border border-pink-500/20 bg-zinc-950 p-6">
              <p class="text-sm uppercase tracking-[0.25em] text-zinc-500">My Code</p>
              <p class="mt-2 text-3xl font-bold tracking-wider text-pink-300">LEROY00307</p>
              <p class="mt-2 text-sm text-zinc-500">Use at checkout.</p>
            </div>

            <a
              href="https://www.theloadedteashop.com/LEROY00307"
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="mt-6 inline-flex w-full items-center justify-center rounded-xl bg-pink-600 px-6 py-4 font-bold text-white transition hover:bg-pink-500"
            >
              Shop The Loaded Tea Shop →
            </a>
          </div>
        </article>

        <!-- Dubby Energy -->
        <article class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 shadow-2xl transition duration-300 hover:-translate-y-2 hover:border-cyan-500/70">
          <div class="relative overflow-hidden bg-gradient-to-br from-cyan-950 via-zinc-950 to-purple-950 p-10">
            <div class="absolute -right-20 -top-20 h-48 w-48 rounded-full bg-cyan-500/20 blur-3xl"></div>
            <div class="absolute -bottom-20 -left-20 h-48 w-48 rounded-full bg-purple-500/20 blur-3xl"></div>
            <div class="relative">
              <p class="text-5xl">⚡</p>
              <p class="mt-6 uppercase tracking-[0.3em] text-cyan-300">Featured Partner</p>
              <h2 class="logo mt-3 text-4xl md:text-5xl">Dubby Energy</h2>
              <p class="mt-5 max-w-xl text-zinc-300">
                Energy and focus products for creators, gamers, streamers, and anybody ready to get the task done.
              </p>
            </div>
          </div>

          <div class="p-8 md:p-10">
            <div class="rounded-2xl border border-cyan-500/20 bg-zinc-950 p-6">
              <p class="text-sm uppercase tracking-[0.25em] text-zinc-500">My Code</p>
              <p class="mt-2 text-3xl font-bold tracking-wider text-cyan-300">ANEpod</p>
              <p class="mt-2 text-sm text-zinc-500">Use my code when shopping Dubby.</p>
            </div>

            <a
              href="https://www.dubby.gg/"
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="mt-6 inline-flex w-full items-center justify-center rounded-xl bg-cyan-600 px-6 py-4 font-bold text-white transition hover:bg-cyan-500"
            >
              Shop Dubby Energy →
            </a>
          </div>
        </article>
      </div>

      <div class="mt-16 rounded-3xl border border-yellow-400/20 bg-zinc-950 p-8 text-center md:p-10">
        <p class="uppercase tracking-[0.35em] text-yellow-400">Support The Work</p>
        <h2 class="logo mt-4 text-4xl md:text-5xl">Shop Through My Links</h2>
        <p class="mx-auto mt-5 max-w-3xl text-zinc-400 leading-8">
          Some links on this page are affiliate or partner links. I may earn a commission when you purchase through my link or use my code, at no additional cost to you.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
