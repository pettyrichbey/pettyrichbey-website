---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | Petty Rich Bey" description="Reach the Bey Mirror Media communications desk by letter, telegram, or telephone.">
  <section class="relative isolate overflow-hidden bg-[#090806] px-5 py-16 text-zinc-100 md:px-8 md:py-24">
    <div class="pointer-events-none absolute inset-0 opacity-20" style="background-image: radial-gradient(ellipse at 50% 0%, rgba(190,150,82,.2), transparent 55%), repeating-linear-gradient(90deg, transparent 0 69px, rgba(255,255,255,.025) 70px 71px);"></div>
    <div class="relative mx-auto max-w-6xl">
      <header class="mx-auto max-w-3xl text-center">
        <p class="text-[10px] uppercase tracking-[.5em] text-amber-200/80">Bey Mirror Media · Communications Department</p>
        <h1 class="logo mt-4 text-5xl text-white md:text-7xl">The Switchboard</h1>
        <p class="mt-5 text-base leading-8 text-zinc-400">Your call has reached the right place. Send a telegram, pick up the telephone, or put your thoughts in a letter. The line is open.</p>
      </header>

      <section class="mt-12 overflow-hidden border border-amber-200/30 bg-gradient-to-br from-[#241b10] via-[#11100e] to-black shadow-2xl">
        <div class="flex items-center justify-between border-b border-amber-200/20 px-5 py-3 text-[9px] uppercase tracking-[.3em] text-zinc-500"><span>Central exchange · Station 01</span><span>All lines connect to Bey Mirror Media</span></div>
        <div class="grid gap-8 p-6 md:grid-cols-2 md:p-10">
          <div class="flex flex-col justify-center">
            <p class="text-[10px] uppercase tracking-[.4em] text-amber-200/70">Now connecting</p>
            <h2 class="logo mt-3 text-4xl text-amber-100 md:text-5xl">Let's Connect.</h2>
            <p class="mt-5 text-sm leading-7 text-zinc-300">For music, publishing, podcast collaborations, media requests, bookings, partnerships, or a simple hello — we'd love to hear from you.</p>
            <div class="mt-7 flex items-center gap-4 border-t border-zinc-700 pt-6">
              <span class="text-3xl text-amber-200">☎</span>
              <div><p class="text-[9px] uppercase tracking-[.3em] text-zinc-500">Direct correspondence</p><a href="mailto:contact@pettyrichbey.com" class="mt-1 text-lg text-amber-100 transition hover:text-white">contact@pettyrichbey.com</a></div>
            </div>
            <div class="mt-5 flex items-center gap-4">
              <span class="text-3xl text-amber-200">✉</span>
              <div><p class="text-[9px] uppercase tracking-[.3em] text-zinc-500">Online address</p><p class="mt-1 text-zinc-200">pettyrichbey.com</p></div>
            </div>
          </div>
          <div class="relative flex min-h-[300px] items-center justify-center overflow-hidden border border-amber-200/20 bg-[radial-gradient(ellipse_at_center,rgba(180,145,87,.15),transparent_70%)] p-5">
            <div class="absolute left-4 top-4 text-[9px] uppercase tracking-[.3em] text-zinc-600">Operator at the ready</div>
            <svg viewBox="0 0 520 330" role="img" aria-label="Vintage telephone switchboard with operator connection lights" class="w-full max-w-xl">
              <defs><linearGradient id="wood" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#705332"/><stop offset="1" stop-color="#21180f"/></linearGradient><linearGradient id="brass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f4d99a"/><stop offset=".5" stop-color="#9a7139"/><stop offset="1" stop-color="#4b351c"/></linearGradient></defs>
              <rect x="55" y="35" width="410" height="260" rx="12" fill="url(#wood)" stroke="url(#brass)" stroke-width="6"/>
              <rect x="75" y="55" width="370" height="175" rx="5" fill="#100e0b" stroke="#9b7846" stroke-width="3"/>
              {#each Array.from({length:8}) as _,i}
                <g>
                  <rect x={91+i*43} y="68" width="30" height="130" rx="3" fill="#211d17" stroke="#78603b"/>
                  {#each Array.from({length:5}) as _,j}
                    <circle cx={106+i*43} cy={84+j*23} r="5" fill={j===1 || j===3 ? "#d8b36c" : "#514333"} stroke="#e2c98e" stroke-width="1"/>
                  {/each}
                </g>
              {/each}
              <rect x="95" y="245" width="330" height="30" rx="4" fill="#100e0b" stroke="#987545"/>
              <text x="260" y="265" text-anchor="middle" fill="#e8d3a3" font-size="12" letter-spacing="4">BEY MIRROR MEDIA EXCHANGE</text>
              <path d="M185 235 Q145 275 170 300 M335 235 Q375 275 350 300" fill="none" stroke="#b18a50" stroke-width="5"/>
              <circle cx="260" cy="245" r="13" fill="url(#brass)"/>
            </svg>
            <p class="absolute bottom-3 right-4 text-[8px] uppercase tracking-[.25em] text-zinc-600">Please hold · Connecting your call</p>
          </div>
        </div>
      </section>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <section class="border border-zinc-700 bg-[#14110d] p-6 md:p-8">
          <div class="flex items-center justify-between"><p class="text-[9px] uppercase tracking-[.35em] text-amber-200/70">The old-fashioned way</p><span class="text-2xl text-amber-200">☎</span></div>
          <h2 class="logo mt-3 text-3xl text-white">Ring the Office</h2>
          <p class="mt-3 text-sm leading-7 text-zinc-400">Our virtual switchboard is always ready to take your message. Reach the office by email and we'll get back to you.</p>
          <a href="mailto:contact@pettyrichbey.com" class="mt-5 inline-flex border border-amber-200/50 px-5 py-3 text-xs uppercase tracking-[.2em] text-amber-100 transition hover:bg-amber-100 hover:text-black">Email the office →</a>
        </section>
        <section class="border border-zinc-700 bg-[#14110d] p-6 md:p-8">
          <div class="flex items-center justify-between"><p class="text-[9px] uppercase tracking-[.35em] text-amber-200/70">Special delivery</p><span class="text-2xl text-amber-200">✉</span></div>
          <h2 class="logo mt-3 text-3xl text-white">Send a Telegram</h2>
          <p class="mt-3 text-sm leading-7 text-zinc-400">Have a booking inquiry, partnership idea, media request, or something to say? Send it through the message desk below.</p>
          <p class="mt-5 border-l-2 border-amber-200/50 pl-4 text-xs italic text-zinc-500">Stop. Look. Listen. Your message matters.</p>
        </section>
      </div>

      <section class="mt-12 grid gap-8 lg:grid-cols-[.8fr_1.2fr]">
        <div class="border border-amber-200/25 bg-[#17120c] p-7 md:p-9">
          <p class="text-[9px] uppercase tracking-[.4em] text-amber-200/70">A letter for the archives</p>
          <h2 class="logo mt-3 text-3xl text-white">A Message You Can Feel.</h2>
          <p class="mt-4 text-sm leading-7 text-zinc-400">A little something special in Braille, celebrating the name behind the work.</p>
          <div class="mt-8 rotate-[-1deg] border border-[#a88c5d] bg-[#d8c49c] p-5 text-center text-[#241a10] shadow-xl">
            <p class="font-serif text-xl italic">Petty Rich Bey</p>
            <div class="mt-4 border-t border-[#8c7048] pt-4">
              <p class="font-mono text-3xl leading-relaxed tracking-[.12em]" aria-label="Petty Rich Bey written in Braille">⠏⠑⠞⠞⠽⠀⠗⠊⠉⠓⠀⠃⠑⠽</p>
              <p class="mt-2 text-[8px] uppercase tracking-[.25em] text-[#665033]">Braille · Raised-dot alphabet</p>
            </div>
          </div>
          <p class="mt-5 text-xs leading-6 text-zinc-500">The Braille line reads “PETTY RICH BEY.”</p>
        </div>

        <div class="border border-zinc-700 bg-[#111] p-7 shadow-2xl md:p-9">
          <p class="text-[9px] uppercase tracking-[.4em] text-amber-200/70">Dispatch desk · Telegram form</p>
          <h2 class="logo mt-3 text-3xl text-white">Send Your Message</h2>
          <p class="mt-3 text-sm leading-6 text-zinc-400">Fill out the form below and leave the details with the office.</p>
          <form class="mt-8 space-y-5">
            <div>
              <label for="name" class="mb-2 block text-xs uppercase tracking-[.2em] text-zinc-400">Your name</label>
              <input id="name" name="name" type="text" placeholder="Your name" class="w-full border border-zinc-700 bg-black px-4 py-3 text-zinc-200 outline-none transition focus:border-amber-200"/>
            </div>
            <div>
              <label for="email" class="mb-2 block text-xs uppercase tracking-[.2em] text-zinc-400">Your email</label>
              <input id="email" name="email" type="email" placeholder="you@example.com" class="w-full border border-zinc-700 bg-black px-4 py-3 text-zinc-200 outline-none transition focus:border-amber-200"/>
            </div>
            <div>
              <label for="subject" class="mb-2 block text-xs uppercase tracking-[.2em] text-zinc-400">Subject</label>
              <input id="subject" name="subject" type="text" placeholder="What's this about?" class="w-full border border-zinc-700 bg-black px-4 py-3 text-zinc-200 outline-none transition focus:border-amber-200"/>
            </div>
            <div>
              <label for="message" class="mb-2 block text-xs uppercase tracking-[.2em] text-zinc-400">Your message</label>
              <textarea id="message" name="message" rows="6" placeholder="Write your telegram here..." class="w-full resize-none border border-zinc-700 bg-black px-4 py-3 text-zinc-200 outline-none transition focus:border-amber-200"></textarea>
            </div>
            <button type="submit" class="w-full border border-amber-200/60 bg-amber-200 px-6 py-4 text-xs font-bold uppercase tracking-[.22em] text-black transition hover:bg-amber-100">Dispatch Message →</button>
          </form>
        </div>
      </section>

      <section class="mt-12 border-t border-zinc-800 pt-8 text-center">
        <p class="text-[9px] uppercase tracking-[.4em] text-amber-200/70">Bey Mirror Media · Central Exchange</p>
        <p class="logo mt-3 text-2xl text-white">Thank you for getting in touch.</p>
        <div class="mt-5 flex flex-wrap justify-center gap-4 text-xs text-zinc-500"><a href="mailto:contact@pettyrichbey.com" class="transition hover:text-amber-100">Email</a><span>·</span><a href="/about" class="transition hover:text-amber-100">About the Studio</a><span>·</span><a href="/vip" class="transition hover:text-amber-100">VIP Club</a></div>
      </section>
    </div>
  </section>
</BaseLayout>
