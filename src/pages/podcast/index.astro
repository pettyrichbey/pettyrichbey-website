---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { podcast } from "../../data/podcast";

const { segments } = podcast;

const apple = "https://podcasts.apple.com/us/podcast/absolutely-no-excuses-podcast/id1888196186";
const rephonic = "https://rephonic.com/podcasts/absolutely-no-excuses-podcast";
const latestEpisode = {
  title: "🔥 Politics, Power & The Divide | Part 1",
  spotify: "https://open.spotify.com/episode/7EUNX3ZjQyRqhy5vskGFjr?si=Ey7cnb8WTzO6QgXcwMJlOw",
  youtube: "https://www.youtube.com/watch?v=qMYAO3uIqk0",
};

const cast = [
  { name: "Petty Rich Bey", role: "Host / Creator", image: "/images/podcast/petty.png" },
  { name: "Lola Lev", role: "Cast", image: "/images/podcast/lola.png" },
  { name: "K-Doc", role: "Cast", image: "/images/podcast/kdoc.png" },
  { name: "E-Flow", role: "Cast", image: "/images/podcast/eflow.png" },
  { name: "Yolie", role: "Cast", image: "/images/podcast/yolie.png" },
];
---

<BaseLayout title={`${podcast.shortTitle} | Petty Rich Bey`}>

  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,.18),transparent_60%)]"></div>

  <div class="relative mx-auto max-w-7xl">

    <div class="mx-auto max-w-4xl text-center">
      <p class="uppercase tracking-[0.45em] text-yellow-400">The Conversation</p>

      <h1 class="logo mt-5 text-6xl md:text-7xl">{podcast.title}</h1>

      <p class="mt-8 text-lg leading-8 text-zinc-400">{podcast.description}</p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={podcast.spotify} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-purple-700 px-8 py-4 font-semibold text-white transition duration-300 hover:-translate-y-1 hover:bg-purple-600 hover:shadow-[0_0_25px_rgba(124,58,237,.4)]">
          🎧 Listen on Spotify →
        </a>

        <a href={podcast.youtube} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-yellow-400 px-8 py-4 font-semibold text-yellow-400 transition duration-300 hover:bg-yellow-400 hover:text-black">
          ▶ Watch on YouTube →
        </a>

        <a href={apple} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-zinc-700 px-8 py-4 font-semibold text-zinc-300 transition duration-300 hover:border-yellow-400 hover:text-yellow-400">
           Apple Podcasts →
        </a>

        <a href={rephonic} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-zinc-700 px-8 py-4 font-semibold text-zinc-300 transition duration-300 hover:border-purple-500 hover:text-purple-300">
          🌐 Find Us Everywhere →
        </a>
      </div>
    </div>

    <div class="mt-20">
      <p class="mb-8 uppercase tracking-[0.35em] text-yellow-400">Latest Episode</p>

      <div class="rounded-3xl border border-yellow-400/20 bg-zinc-950 p-8 md:p-10">
        <p class="text-sm uppercase tracking-[0.3em] text-zinc-500">Now Playing</p>
        <h2 class="logo mt-4 text-4xl md:text-5xl">{latestEpisode.title}</h2>
        <p class="mt-5 max-w-3xl leading-7 text-zinc-400">
          Part 1 of a conversation about politics, power, perspectives, and the divide shaping the conversation.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a href={latestEpisode.spotify} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-purple-700 px-6 py-3 font-semibold text-white transition duration-300 hover:bg-purple-600">
            🎧 Listen on Spotify
          </a>
          <a href={latestEpisode.youtube} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-yellow-400 px-6 py-3 font-semibold text-yellow-400 transition duration-300 hover:bg-yellow-400 hover:text-black">
            ▶ Watch on YouTube
          </a>
        </div>
      </div>
    </div>

    <div class="mt-20">
      <p class="mb-8 uppercase tracking-[0.35em] text-yellow-400">Featured Show</p>

      <div class="group grid overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 lg:grid-cols-2">
        <div class="relative overflow-hidden bg-zinc-950">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(124,58,237,.25),transparent_65%)]"></div>
          <img src="/images/podcast/anepod.png" alt="Absolutely No Excuses Podcast" class="relative z-10 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
        </div>

        <div class="flex flex-col justify-center p-10 md:p-14">
          <p class="uppercase tracking-[0.35em] text-yellow-400">{podcast.shortTitle}</p>
          <h2 class="logo mt-5 text-5xl md:text-6xl">{podcast.tagline}</h2>
          <p class="mt-6 text-lg leading-8 text-zinc-400">{podcast.description}</p>

          <div class="mt-8 flex flex-wrap gap-4 text-sm text-zinc-500">
            <span>Conversations</span><span>•</span><span>Culture</span><span>•</span><span>Entertainment</span>
          </div>

          <div class="mt-10 flex flex-wrap gap-4">
            <a href={podcast.spotify} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-purple-700 px-6 py-3 font-semibold text-white transition duration-300 hover:bg-purple-600">Listen on Spotify</a>
            <a href={podcast.youtube} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-zinc-700 px-6 py-3 font-semibold text-zinc-300 transition duration-300 hover:border-yellow-400 hover:text-yellow-400">Watch on YouTube</a>
            <a href={apple} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-zinc-700 px-6 py-3 font-semibold text-zinc-300 transition duration-300 hover:border-yellow-400 hover:text-yellow-400">Apple Podcasts</a>
            <a href={rephonic} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-zinc-700 px-6 py-3 font-semibold text-zinc-300 transition duration-300 hover:border-purple-500 hover:text-purple-300">Find Us Everywhere</a>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-24">
      <div class="mb-10 text-center">
        <p class="uppercase tracking-[0.35em] text-yellow-400">The People Behind ANE</p>
        <h2 class="logo mt-4 text-5xl md:text-6xl">Meet the Cast</h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-zinc-400">
          The personalities behind the microphones, the conversations, and the ANE experience.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {cast.map((member) => (
          <article class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-950 transition duration-500 hover:-translate-y-2 hover:border-purple-500 hover:shadow-[0_20px_50px_rgba(124,58,237,.18)]">
            <div class="relative overflow-hidden bg-zinc-900">
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(124,58,237,.18),transparent_65%)]"></div>
              <img
                src={member.image}
                alt={`${member.name} - ANE Podcast cast member`}
                class="relative z-10 aspect-[4/5] w-full object-cover transition duration-700 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-7">
              <p class="text-sm uppercase tracking-[0.3em] text-yellow-400">{member.role}</p>
              <h3 class="logo mt-3 text-3xl">{member.name}</h3>
              <div class="mt-5 h-px w-16 bg-purple-600 transition-all duration-300 group-hover:w-24"></div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div id="episodes" class="mt-24">
      <div class="mb-10">
        <p class="uppercase tracking-[0.35em] text-yellow-400">The ANE Universe</p>
        <h2 class="logo mt-4 text-5xl">More Than a Podcast</h2>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-400">
          ANE Podcast has grown into a collection of conversations, recurring segments, and shows built around the personalities behind the microphone.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        {segments.map((segment) => (
          <a href={podcast.youtube} target="_blank" rel="noopener noreferrer" class="group rounded-3xl border border-zinc-800 bg-zinc-900 p-8 transition duration-300 hover:-translate-y-2 hover:border-purple-500">
            <p class="text-4xl">{segment.icon}</p>
            <p class="mt-6 text-sm uppercase tracking-[0.3em] text-yellow-400">{segment.type}</p>
            <h3 class="logo mt-3 text-3xl">{segment.title}</h3>
            <p class="mt-4 text-zinc-400">{segment.description}</p>
            <div class="mt-8 font-semibold text-yellow-400 transition-transform duration-300 group-hover:translate-x-2">Watch on YouTube →</div>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-24">
      <div class="rounded-3xl border border-yellow-400/20 bg-zinc-950 p-10 text-center md:p-16">
        <p class="uppercase tracking-[0.4em] text-yellow-400">Choose Your Experience</p>
        <h2 class="logo mt-5 text-4xl md:text-5xl">Listen. Watch. Join the Conversation.</h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-zinc-400">
          Catch ANE Podcast wherever you prefer. Listen to the show on Spotify or Apple Podcasts, watch the conversations on YouTube, or find ANE across listening platforms through Rephonic.
        </p>

        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <a href={podcast.spotify} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-purple-700 px-8 py-4 font-semibold text-white transition duration-300 hover:-translate-y-1 hover:bg-purple-600">🎧 Spotify →</a>
          <a href={podcast.youtube} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-yellow-400 px-8 py-4 font-semibold text-yellow-400 transition duration-300 hover:bg-yellow-400 hover:text-black">▶ YouTube →</a>
          <a href={apple} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-zinc-700 px-8 py-4 font-semibold text-zinc-300 transition duration-300 hover:border-yellow-400 hover:text-yellow-400"> Apple Podcasts →</a>
          <a href={rephonic} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-zinc-700 px-8 py-4 font-semibold text-zinc-300 transition duration-300 hover:border-purple-500 hover:text-purple-300">🌐 Rephonic →</a>
        </div>
      </div>
    </div>

    <div class="mt-24">
      <div class="rounded-3xl border border-zinc-800 bg-zinc-900 p-10 text-center md:p-14">
        <p class="uppercase tracking-[0.35em] text-yellow-400">Behind the Mic</p>
        <h2 class="logo mt-4 text-4xl md:text-5xl">The People Behind the Conversations</h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-zinc-400">
          Meet the cast that helps bring the ANE universe to life.
        </p>
      </div>
    </div>

  </div>

</BaseLayout>