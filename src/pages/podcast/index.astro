---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Podcast | Petty Rich Bey">

  <section class="relative overflow-hidden px-8 py-24">

    <!-- Atmospheric Glow -->

    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(124,58,237,.18),transparent_60%)]"
    ></div>

    <div class="relative mx-auto max-w-7xl">

      <!-- Podcast Header -->

      <div class="mx-auto max-w-4xl text-center">

        <p class="uppercase tracking-[0.45em] text-yellow-400">
          The Conversation
        </p>

        <h1 class="logo mt-5 text-6xl md:text-7xl">
          Absolutely No Excuses Podcast
        </h1>

        <p class="mt-8 text-lg leading-8 text-zinc-400">
          Real conversations. Real perspectives. No excuses.
          Step inside the conversations, debates, stories, and personalities
          that make ANE Podcast what it is.
        </p>

      </div>


      <!-- Featured Podcast -->

      <div class="mt-20">

        <p class="mb-8 uppercase tracking-[0.35em] text-yellow-400">
          Featured Show
        </p>

        <div
          class="group grid overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 lg:grid-cols-2"
        >

          <!-- Podcast Visual -->

          <div
            class="relative flex min-h-[420px] items-center justify-center overflow-hidden bg-zinc-950"
          >

            <div
              class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(124,58,237,.25),transparent_65%)]"
            ></div>

            <div class="relative z-10 text-center">

              <p class="text-7xl font-bold text-yellow-400">
                ANE
              </p>

              <p class="mt-4 text-sm uppercase tracking-[0.4em] text-zinc-400">
                Absolutely No Excuses
              </p>

              <p class="mt-3 text-xs uppercase tracking-[0.3em] text-zinc-600">
                Podcast
              </p>

            </div>

          </div>


          <!-- Podcast Information -->

          <div class="flex flex-col justify-center p-10 md:p-14">

            <p class="uppercase tracking-[0.35em] text-yellow-400">
              Absolutely No Excuses Podcast
            </p>

            <h2 class="logo mt-5 text-5xl md:text-6xl">
              The Conversation
            </h2>

            <p class="mt-6 text-lg leading-8 text-zinc-400">
              From messy conversations to health and wellness,
              entertainment, culture, and everything in between,
              ANE Podcast brings honest conversations without the filter.
            </p>

            <div class="mt-8 flex flex-wrap gap-4 text-sm text-zinc-500">

              <span>Conversations</span>

              <span>•</span>

              <span>Culture</span>

              <span>•</span>

              <span>Entertainment</span>

            </div>

            <a
              href="#episodes"
              class="mt-10 inline-block w-fit rounded-xl bg-purple-700 px-8 py-4 font-semibold text-white transition duration-300 hover:-translate-y-1 hover:bg-purple-600 hover:shadow-[0_0_25px_rgba(124,58,237,.4)]"
            >
              Explore the Podcast →
            </a>

          </div>

        </div>

      </div>


      <!-- Podcast Segments -->

      <div
        id="episodes"
        class="mt-24"
      >

        <div class="mb-10">

          <p class="uppercase tracking-[0.35em] text-yellow-400">
            The ANE Universe
          </p>

          <h2 class="logo mt-4 text-5xl">
            More Than a Podcast
          </h2>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-400">
            ANE Podcast has grown into a collection of conversations,
            recurring segments, and shows built around the personalities
            behind the microphone.
          </p>

        </div>


        <!-- Segment Grid -->

        <div class="grid gap-8 md:grid-cols-2">


          <!-- Podcast Fridays -->

          <article
            class="group rounded-3xl border border-zinc-800 bg-zinc-900 p-8 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <p class="text-4xl">
              🎙️
            </p>

            <h3 class="logo mt-6 text-3xl">
              Podcast Fridays
            </h3>

            <p class="mt-4 text-zinc-400">
              The main ANE Podcast experience featuring conversations,
              debates, stories, guests, and plenty of personality.
            </p>

            <div class="mt-8 font-semibold text-yellow-400">
              Explore Episodes →
            </div>

          </article>


          <!-- Messy Mondays -->

          <article
            class="group rounded-3xl border border-zinc-800 bg-zinc-900 p-8 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <p class="text-4xl">
              💋
            </p>

            <h3 class="logo mt-6 text-3xl">
              Messy Mondays
            </h3>

            <p class="mt-4 text-zinc-400">
              The conversations get messy, the opinions get louder,
              and absolutely nobody gets a free pass.
            </p>

            <div class="mt-8 font-semibold text-yellow-400">
              Explore Messy Mondays →
            </div>

          </article>


          <!-- Health & Wellness -->

          <article
            class="group rounded-3xl border border-zinc-800 bg-zinc-900 p-8 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <p class="text-4xl">
              🧠
            </p>

            <h3 class="logo mt-6 text-3xl">
              Health & Wellness
            </h3>

            <p class="mt-4 text-zinc-400">
              Honest conversations about wellness, healthy behavior,
              personal growth, and taking care of yourself.
            </p>

            <div class="mt-8 font-semibold text-yellow-400">
              Explore Health & Wellness →
            </div>

          </article>


          <!-- Wild Out Wednesday -->

          <article
            class="group rounded-3xl border border-zinc-800 bg-zinc-900 p-8 transition duration-300 hover:-translate-y-2 hover:border-purple-500"
          >

            <p class="text-4xl">
              🔥
            </p>

            <h3 class="logo mt-6 text-3xl">
              Wild Out Wednesday
            </h3>

            <p class="mt-4 text-zinc-400">
              The energy turns all the way up with stories,
              personalities, entertainment, and unapologetic fun.
            </p>

            <div class="mt-8 font-semibold text-yellow-400">
              Explore Wild Out Wednesday →
            </div>

          </article>


        </div>

      </div>


      <!-- Behind the Mic -->

      <div class="mt-24">

        <div
          class="rounded-3xl border border-zinc-800 bg-zinc-900 p-10 text-center md:p-14"
        >

          <p class="uppercase tracking-[0.35em] text-yellow-400">
            Behind the Mic
          </p>

          <h2 class="logo mt-4 text-4xl md:text-5xl">
            The People Behind the Conversations
          </h2>

          <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-zinc-400">
            Meet the personalities, guests, and voices that help bring
            the ANE universe to life.
          </p>

        </div>

      </div>

    </div>

  </section>

</BaseLayout>