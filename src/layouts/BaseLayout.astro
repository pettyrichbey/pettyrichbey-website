---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Petty Rich Bey | Music • Author • Creator",
  description =
    "The official website of Petty Rich Bey. Explore music, books, podcast episodes, videos, and more.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Petty Rich Bey, music, books, podcast, author, artist"
    />
    <meta name="author" content="Petty Rich Bey" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
  href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
  rel="stylesheet"
/>
  </head>

  <body class="bg-zinc-950 text-white">
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
