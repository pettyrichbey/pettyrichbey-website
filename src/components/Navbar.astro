---
import { navigation } from "../data/navigation";
---
<header class="prb-topbar sticky top-0 z-50 w-full">
  <div class="prb-topline flex items-center justify-center gap-3 py-1.5 text-[8px] uppercase tracking-[.42em]"><span>✦</span> Bey Mirror Media proudly presents <span>✦</span></div>
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 md:px-8" aria-label="Main navigation">
    <a href="/" class="flex shrink-0 items-center" aria-label="Petty Rich Bey home">
      <img src="/images/logos/logo.png" alt="Petty Rich Bey" class="h-14 w-auto object-contain md:h-[68px]" />
    </a>
    <ul class="hidden items-center gap-4 xl:gap-5 md:flex">
      {navigation.map((item) => (
        <li><a href={item.href} class="prb-navlink whitespace-nowrap text-[9px] font-medium uppercase tracking-[.13em] transition">{item.label}</a></li>
      ))}
    </ul>
    <a href="/tunnel-of-love" class="prb-ticket hidden shrink-0 px-4 py-3 text-[10px] font-bold uppercase tracking-[.18em] md:inline-flex">Now showing: Tunnel of Love</a>
    <details class="relative md:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center border border-[#d8c39a66] bg-[#111] text-[#eee] [&::-webkit-details-marker]:hidden" aria-label="Open navigation menu"><span class="text-2xl leading-none">☰</span></summary>
      <div class="absolute right-0 z-50 mt-3 w-64 border border-[#d8c39a55] bg-[#101010] p-3 shadow-2xl">
        <nav aria-label="Mobile navigation"><ul class="space-y-1">
          {navigation.map((item) => (<li><a href={item.href} class="prb-navlink block px-4 py-3 text-[10px] font-medium uppercase tracking-[.12em] transition">{item.label}</a></li>))}
        </ul><a href="/tunnel-of-love" class="mt-3 block border border-[#d8c39a] bg-[#d8c39a] px-4 py-3 text-center text-xs font-bold uppercase tracking-[.15em] text-black">Now showing · Tunnel of Love</a></nav>
      </div>
    </details>
  </nav>
</header>
