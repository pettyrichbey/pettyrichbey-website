---
import { navigation } from "../data/navigation";
---

<header class="w-full border-b border-zinc-800 bg-zinc-950">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2 md:px-6"
    aria-label="Main navigation"
  >
    <!-- Logo -->

    <a href="/" class="flex shrink-0 items-center">
      <img
        src="/images/logos/logo.png"
        alt="Petty Rich Bey"
        class="h-16 w-auto object-contain md:h-[82px]"
      />
    </a>

    <!-- Desktop Navigation -->

    <ul class="hidden items-center gap-8 md:flex">
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class="font-semibold text-zinc-300 transition-all duration-300 [text-shadow:0_0_8px_rgba(124,58,237,0.45)] hover:text-white hover:[text-shadow:0_0_14px_rgba(168,85,247,1)]"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Desktop Listen Button -->

    <a
      href="/music"
      class="hidden shrink-0 rounded-lg bg-purple-700 px-5 py-2 font-semibold text-white transition hover:bg-purple-600 md:inline-flex"
    >
      Listen Now
    </a>

    <!-- Mobile Menu -->

    <details class="relative md:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-zinc-700 bg-zinc-900 text-zinc-200 transition hover:border-purple-500 hover:text-white [&::-webkit-details-marker]:hidden"
        aria-label="Open navigation menu"
      >
        <span class="text-2xl leading-none">☰</span>
      </summary>

      <div
        class="absolute right-0 z-50 mt-3 w-64 overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950/95 p-3 shadow-2xl backdrop-blur-xl"
      >
        <nav aria-label="Mobile navigation">
          <ul class="space-y-1">
            {
              navigation.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="block rounded-xl px-4 py-3 font-semibold text-zinc-300 transition hover:bg-zinc-900 hover:text-white"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="mt-3 border-t border-zinc-800 pt-3">
            <a
              href="/music"
              class="block rounded-xl bg-purple-700 px-4 py-3 text-center font-semibold text-white transition hover:bg-purple-600"
            >
              Listen Now
            </a>
          </div>
        </nav>
      </div>
    </details>
  </nav>
</header>