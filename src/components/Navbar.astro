---
import { navigation } from "../data/navigation";
---

<header class="sticky top-0 z-50 bg-zinc-950/80 backdrop-blur border-b border-zinc-800">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">

    <a
      href="/"
      class="text-2xl font-bold tracking-wide text-white hover:text-purple-400 transition-colors"
    >
      Petty Rich Bey
    </a>

    <ul class="hidden md:flex items-center gap-8">
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-zinc-400 transition hover:text-yellow-400"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="/music"
      class="hidden md:inline-flex rounded-lg bg-purple-700 px-5 py-2 font-semibold text-white transition hover:bg-purple-600"
    >
      Listen Now
    </a>

  </nav>
</header>