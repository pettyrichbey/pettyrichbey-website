---
import { navigation } from "../data/navigation";
---

<header class="border-b border-zinc-800">
  <div class="mx-auto flex min-h-[110px] max-w-7xl items-center justify-between px-6">

    <!-- Logo -->

    <a href="/" class="flex shrink-0 items-center">
      <img
        src="/Images/logos/prb site logo.png"
        alt="Petty Rich Bey"
        class="h-[82px] w-auto object-contain"
      />
    </a>

    <!-- Navigation -->

    <ul class="hidden md:flex items-center gap-8">
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class="font-semibold text-zinc-300 transition-all duration-300 [text-shadow:0_0_8px_rgba(124,58,237,0.45)] hover:text-white hover:[text-shadow:0_0_14px_rgba(168,85,247,1)]"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Listen Button -->

    <a
      href="/music"
      class="hidden md:inline-flex shrink-0 rounded-lg bg-purple-700 px-5 py-2 font-semibold text-white transition hover:bg-purple-600"
    >
      Listen Now
    </a>

  </div>
</header>