---
const { tracks } = Astro.props;
---

<section class="mt-24">

  <div class="mb-10">

    <p class="uppercase tracking-[0.4em] text-yellow-400">
      Tracklist
    </p>

    <h2 class="logo mt-4 text-5xl">
      Pure Vibes. Check out the new album "Daydreaming".
      <span class="mt-3 block text-2xl text-zinc-400">
        Album in stores 10/12/26.
      </span>
    </h2>

  </div>

  <div class="overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900">

    {tracks.map((track, index) => (

      <div
        class="group flex items-center gap-6 border-b border-zinc-800 px-6 py-5 last:border-b-0 transition duration-300 hover:bg-zinc-800/60"
      >

        <!-- Play Button -->

        <button
          type="button"
          aria-label={`Play ${track.title}`}
          data-audio={track.audio}
          class="play-button flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-purple-800 text-white transition duration-300 hover:scale-105 hover:bg-purple-600 disabled:cursor-not-allowed disabled:opacity-40"
          disabled={!track.audio}
        >
          ▶
        </button>

        <!-- Track Number -->

        <span class="w-8 text-sm text-zinc-600">
          {(index + 1).toString().padStart(2, "0")}
        </span>

        <!-- Track Information -->

        <div class="flex flex-1 items-center gap-4">

          <span class="text-lg text-zinc-200">
            {track.title}
          </span>

          {track.type && (
            <span class="text-xs uppercase tracking-[0.2em] text-zinc-600">
              {track.type}
            </span>
          )}

        </div>

        <!-- Duration -->

        {track.duration && (
          <span class="text-sm text-zinc-500">
            {track.duration}
          </span>
        )}

      </div>

    ))}

  </div>

</section>

<script>
  const buttons =
    document.querySelectorAll<HTMLButtonElement>(".play-button");

  let currentAudio: HTMLAudioElement | null = null;
  let currentButton: HTMLButtonElement | null = null;

  buttons.forEach((button) => {
    button.addEventListener("click", async () => {

      const source = button.dataset.audio;

      if (!source) {
        return;
      }

      // Clicking the currently selected track
      if (currentAudio && currentButton === button) {

        if (currentAudio.paused) {
          await currentAudio.play();
          button.textContent = "❚❚";
        } else {
          currentAudio.pause();
          button.textContent = "▶";
        }

        return;
      }

      // Stop the previous track
      if (currentAudio) {
        currentAudio.pause();
        currentAudio.currentTime = 0;
      }

      if (currentButton) {
        currentButton.textContent = "▶";
      }

      // Create the new audio player
      const audio = new Audio(source);

      currentAudio = audio;
      currentButton = button;

      try {
        await audio.play();
        button.textContent = "❚❚";
      } catch (error) {
        console.error("Audio playback failed:", error);
        button.textContent = "▶";
      }

      // Reset button when the song finishes
      audio.addEventListener("ended", () => {
        button.textContent = "▶";
        currentAudio = null;
        currentButton = null;
      });

    });
  });
</script>