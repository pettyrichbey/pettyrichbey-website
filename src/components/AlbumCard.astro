---
const { album } = Astro.props;
---

<a
  href={album.link}
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950/80 transition duration-300 hover:-translate-y-1 hover:border-[#c8b58b]/50 hover:shadow-[0_18px_50px_rgba(0,0,0,.3)]"
>
  <div class="aspect-[5/4] overflow-hidden bg-zinc-900">
    <img
      src={album.image}
      alt={`${album.title} album cover`}
      loading="lazy"
      class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.035]"
    />
  </div>

  <div class="flex flex-1 flex-col p-5 md:p-6">
    <p class="text-[10px] uppercase tracking-[0.3em] text-[#c8b58b]">
      {album.type}
    </p>

    <h2 class="logo mt-3 text-2xl leading-tight text-zinc-100 md:text-3xl">
      {album.title}
    </h2>

    <p class="mt-3 line-clamp-3 text-sm leading-6 text-zinc-400">
      {album.description}
    </p>

    <div class="mt-auto flex items-center justify-between gap-4 pt-6 text-xs tracking-wide text-zinc-500">
      <span>{album.year}</span>
      <span>{album.tracks} Tracks</span>
    </div>

    <div class="mt-4 border-t border-zinc-800 pt-4 text-sm font-medium text-[#c8b58b] transition group-hover:text-[#ead7ad]">
      Explore release <span class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>
    </div>
  </div>
</a>
