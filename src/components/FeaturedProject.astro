---
import { featuredProject } from "../data/featured";
---

<section class="py-28">

<div class="mx-auto max-w-7xl px-8">

<div
class="rounded-3xl border border-zinc-800 bg-zinc-900 p-12"
>

<p class="uppercase tracking-[0.35em] text-yellow-400">

{featuredProject.type}

</p>

<h2 class="logo mt-6 text-5xl">

{featuredProject.title}

</h2>

<p class="mt-8 max-w-3xl text-lg leading-8 text-zinc-400">

{featuredProject.description}

</p>

<a
href={featuredProject.link}
class="mt-10 inline-block rounded-xl bg-purple-700 px-8 py-4 font-semibold transition hover:bg-purple-600"
>

{featuredProject.button}

</a>

</div>

</div>

</section>