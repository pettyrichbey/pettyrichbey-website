---
import { featuredProject } from "../data/featured";
---

<section class="relative overflow-hidden border-y border-zinc-800">

  <!-- Atmospheric Glow -->

  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(124,58,237,.18),transparent_55%)]"
  ></div>

  <div
    class="relative mx-auto grid max-w-7xl items-center gap-16 px-8 py-24 lg:grid-cols-[1.1fr_.9fr]"
  >

    <!-- Project Information -->

    <div>

      <p class="mb-5 uppercase tracking-[0.45em] text-yellow-400">
        {featuredProject.type}
      </p>

      <h2 class="logo text-6xl leading-none md:text-7xl lg:text-8xl">
        {featuredProject.title}
      </h2>

      <p class="mt-8 max-w-2xl text-xl leading-9 text-zinc-300">
        {featuredProject.description}
      </p>

      <p class="mt-6 text-lg font-semibold text-zinc-400">
        {featuredProject.releaseDate}
      </p>

      <div class="mt-10">

        <a
          href={featuredProject.link}
          class="inline-flex rounded-xl bg-purple-800 px-8 py-4 font-semibold text-white shadow-[0_0_20px_rgba(124,58,237,.25)] transition duration-300 hover:-translate-y-1 hover:bg-purple-600 hover:shadow-[0_0_30px_rgba(168,85,247,.45)]"
        >
          {featuredProject.button}
        </a>

      </div>

    </div>

    <!-- Featured Project Artwork -->

    <div class="flex justify-center">

      <div
        class="group relative w-full max-w-[480px] overflow-hidden rounded-3xl border border-yellow-400/20 bg-zinc-900 shadow-2xl transition duration-500 hover:-translate-y-2 hover:border-purple-500/50"
      >

        <div
          class="absolute inset-0 z-10 bg-gradient-to-t from-black/70 via-transparent to-transparent"
        ></div>

        <img
          src={featuredProject.image}
          alt={`${featuredProject.title} album cover`}
          class="relative aspect-square w-full object-cover transition duration-700 group-hover:scale-105"
        />

        <div class="absolute bottom-0 left-0 z-20 w-full p-8">

          <p class="text-sm uppercase tracking-[0.35em] text-yellow-400">
            {featuredProject.type}
          </p>

          <p class="logo mt-2 text-4xl text-white">
            {featuredProject.title}
          </p>

          <p class="mt-2 text-sm text-zinc-300">
            {featuredProject.releaseDate}
          </p>

        </div>

      </div>

    </div>

  </div>

</section>